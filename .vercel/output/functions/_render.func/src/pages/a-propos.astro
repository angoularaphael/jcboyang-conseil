---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Method from '../components/Method.astro';
import Footer from '../components/Footer.astro';

const galeryImages = [
  { src: '/images/aout2025/Séminaire août 2025 3.jpeg', alt: 'Séminaire international août 2025', label: 'Séminaire Août 2025' },
  { src: '/images/dec2025/P1170148.JPG', alt: 'Événement décembre 2025', label: 'Décembre 2025' },
  { src: '/images/2019/Forum AKOMCA 2019_1.jpg', alt: 'Forum AKOMCA 2019', label: 'Forum AKOMCA 2019' },
  { src: '/images/dec2025/P1170240.JPG', alt: 'Networking décembre 2025', label: 'Networking' },
];

const credentials = [
  'Consultant certifié',
  'Formateur en ESC',
  'Coach professionnel',
  'Partenaire AKOMCA',
  'International'
];
---
<Layout title="JCBO — Expert Business Development Toulouse | Jean-Christophe Boyang-Tsang" description="Découvrez le parcours de Jean-Christophe Boyang-Tsang, consultant expert en business development avec 30 ans d'expérience terrain.">
  <Header />
  <div class="pt-24"></div>

  <!-- ====== PRÉSENTATION JC BOYANG ====== -->
  <section class="py-20 md:py-28 bg-white" id="about">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.3fr] gap-12 lg:gap-16 items-center">
        <!-- Image principale + badge -->
        <div class="relative" data-animate="fade-right">
          <div class="relative rounded-2xl overflow-hidden aspect-[3/4] max-w-[380px] mx-auto lg:mx-0 shadow-xl">
            <img src="/images/2022/IMG-20240503-WA0065.jpg" alt="Jean-Christophe Boyang-Tsang, fondateur de JCBO Conseil" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <!-- Badge expérience -->
          <div class="absolute -bottom-5 -right-3 lg:-right-5 bg-navy text-white py-5 px-7 rounded-xl shadow-xl text-center">
            <span class="block font-heading text-3xl font-bold text-gold leading-none">30+</span>
            <span class="text-[0.7rem] uppercase tracking-widest text-white/60">ans d'expertise</span>
          </div>
        </div>

        <!-- Content -->
        <div data-animate="fade-left">
          <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Qui vous accompagne</span>
          <h1 class="font-heading text-[clamp(2rem,4vw,3rem)] font-bold text-navy mb-1">Jean-Christophe <span class="text-gold">Boyang-Tsang</span></h1>
          <p class="text-gold font-accent italic text-xl mb-8">Consultant Expert en Business Development</p>

          <div class="space-y-4 text-gray-600 leading-relaxed text-lg">
            <p>
              <strong class="text-navy">JCBo</strong>, ce sont les initiales de Jean-Christophe Boyang-Tsang, fondateur et unique force motrice derrière notre entreprise. Pas un théoricien — <strong class="text-navy">un homme de terrain</strong>.
            </p>
            <p>
              Professionnel expérimenté avec <strong class="text-navy">30 années de pratique</strong> dans les domaines du consulting, de la formation et du coaching. J'interviens comme expert en développement commercial et marketing, ainsi que coach et formateur professionnel en écoles supérieures de commerce en France.
            </p>
            <p>
              Mon expérience couvre la définition et la mise en œuvre de stratégies commerciales pour de nombreuses PME et TPE, l'enseignement en écoles supérieures, et des postes de direction commerciale et marketing dans différents pays. J'organise également régulièrement des <strong class="text-navy">séminaires, formations et événements internationaux</strong>.
            </p>
          </div>

          <!-- Credentials -->
          <div class="flex flex-wrap gap-2 mt-10 mb-10">
            {credentials.map(c => (
              <div class="flex items-center gap-2 bg-offwhite border border-gold/10 rounded-lg px-4 py-2.5 text-sm hover:border-gold/30 transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span class="text-navy font-medium">{c}</span>
              </div>
            ))}
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3.5 px-8 rounded-full hover:bg-gold-light hover:-translate-y-0.5 transition-all">Discuter de votre situation</a>
          </div>
        </div>
      </div>

      <!-- Galerie photos JC Boyang -->
      <div class="mt-20 pt-14 border-t border-gold/10" data-animate="fade-up">
        <div class="text-center mb-10">
          <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">En images</span>
          <h3 class="font-heading text-xl md:text-2xl font-bold text-navy">Séminaires, formations & <span class="text-gold">événements</span></h3>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {galeryImages.map((img, i) => (
            <div class="relative rounded-xl overflow-hidden aspect-square group" data-animate="fade-up" data-delay={String(i * 100)}>
              <img src={img.src} alt={img.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                <span class="text-white text-xs font-semibold bg-gold/90 px-3 py-1 rounded-full">{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Method />

  <!-- CTA -->
  <section class="py-20 bg-navy text-center">
    <div class="max-w-[700px] mx-auto px-6" data-animate="fade-up">
      <h2 class="font-heading text-[clamp(1.6rem,3.5vw,2.4rem)] font-bold text-white mb-4">Envie d'en <span class="text-gold">discuter</span> ?</h2>
      <p class="text-white/50 mb-8">Chaque situation est unique. Parlons de la vôtre et structurons votre croissance.</p>
      <div class="flex items-center justify-center gap-4 flex-wrap">
        <a href="/reserver" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-4 px-10 rounded-full text-lg hover:bg-gold-light hover:-translate-y-0.5 transition-all">Réserver une séance</a>
        <a href="/contact" class="inline-flex items-center gap-2 border border-white/30 text-white font-bold py-4 px-10 rounded-full text-lg hover:border-gold hover:text-gold transition-all">Nous contacter</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
