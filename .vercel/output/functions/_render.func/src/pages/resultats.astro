---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Results from '../components/Results.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Nos Résultats — JCBO Conseil | Preuves Terrain" description="Séminaires, formations et événements internationaux. Découvrez nos résultats en images et les témoignages de nos clients.">
  <Header />
  <div class="pt-24"></div>
  <Results />
  <Testimonials />

  <!-- CTA -->
  <section class="py-16 bg-offwhite text-center">
    <div class="max-w-[700px] mx-auto px-6">
      <h2 class="font-heading text-2xl font-bold text-navy mb-4">Rejoignez nos <span class="text-gold">clients satisfaits</span></h2>
      <p class="text-gray-500 mb-8">Vous aussi, transformez votre activité avec un accompagnement expert.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3.5 px-8 rounded-full hover:bg-gold-light transition-all">Être recontacté</a>
    </div>
  </section>

  <Footer />
</Layout>
