---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { heroMedia } from '../data/hero-media';

import { apiUrl } from '../data/site-config';

let articles: {
  title: string;
  category: string;
  date: string;
  excerpt: string;
  image: string | null;
  slug: string;
}[] = [];

try {
  const res = await fetch(`${apiUrl}/api/public/actualites`);
  if (res.ok) {
    const data = await res.json();
    articles = (data.articles ?? []).map((a: { title: string; category: string; date: string; excerpt: string; image: string | null; slug: string }) => ({
      ...a,
      date: new Date(a.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }),
    }));
  }
} catch {
  articles = [];
}

const categories = ['Tous', 'Stratégie', 'Mindset', 'Vendeur Attitude', 'Coaching', 'Actualité'];
---
<Layout title="Actualités — JCBO Conseil | Articles, Conseils & Expertise" description="Articles, conseils et actualités sur le développement commercial, le mindset entrepreneurial et la méthode Vendeur Attitude. Expertise JCBO Conseil.">
  <Header />
  <div class="pt-24"></div>

  <PageHero imageSrc={heroMedia.actualites.image} imageAlt={heroMedia.actualites.alt}>
    <div class="max-w-[800px] mx-auto px-6">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-3">Blog & Expertise</span>
      <h1 class="font-heading text-[clamp(1.8rem,4vw,2.8rem)] font-bold mb-4">Nos <span class="text-gold">Actualités</span></h1>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
      <p class="text-white/60">Articles publiés par l'équipe JCBO Conseil.</p>
    </div>
  </PageHero>

  <section class="bg-gold/10 border-b border-gold/10">
    <div class="max-w-[800px] mx-auto px-6 py-8 flex flex-col md:flex-row items-center gap-5">
      <div class="flex-1">
        <h3 class="font-heading text-lg font-bold text-navy mb-1">Newsletter JCBO Conseil</h3>
        <p class="text-gray-500 text-sm">Recevez nos meilleurs conseils stratégiques directement dans votre boîte mail.</p>
      </div>
      <form class="flex gap-2 w-full md:w-auto" id="newsletterForm">
        <input type="email" name="email" placeholder="votre@email.com" required class="flex-1 md:w-64 px-4 py-3 rounded-xl border border-gray-200 focus:border-gold outline-none text-sm" />
        <button type="submit" class="bg-gold text-navy font-bold px-6 py-3 rounded-xl hover:bg-gold-light transition-all text-sm whitespace-nowrap">S'inscrire</button>
      </form>
      <p id="newsletter-msg" class="text-sm hidden"></p>
    </div>
  </section>

  <section class="bg-white border-b border-gray-100">
    <div class="max-w-[1200px] mx-auto px-6 py-4 flex items-center gap-2 overflow-x-auto">
      {categories.map((cat, i) => (
        <button class:list={["px-4 py-2 rounded-full text-sm font-medium transition-all whitespace-nowrap", i === 0 ? "bg-navy text-white" : "bg-offwhite text-gray-500 hover:bg-navy/10"]} data-filter={cat}>{cat}</button>
      ))}
    </div>
  </section>

  <section class="py-16 bg-offwhite">
    <div class="max-w-[1200px] mx-auto px-6">
      {articles.length === 0 ? (
        <p class="text-center text-gray-500">Aucune actualité publiée pour le moment.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="articles-grid">
          {articles.map(a => (
            <article class="bg-white rounded-2xl border border-gold/10 overflow-hidden hover:-translate-y-1 hover:shadow-lg transition-all group" data-category={a.category}>
              <div class="aspect-[16/10] bg-navy/10 overflow-hidden">
                {a.image ? (
                  <img src={a.image} alt="" class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-navy/20 to-gold/10 flex items-center justify-center">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="1.5" class="opacity-40"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-xs font-medium bg-gold/10 text-gold-dark px-3 py-1 rounded-full">{a.category}</span>
                  <span class="text-xs text-gray-400">{a.date}</span>
                </div>
                <h3 class="font-heading text-lg font-bold text-navy mb-2 group-hover:text-gold transition-colors">{a.title}</h3>
                <p class="text-gray-500 text-sm mb-4 line-clamp-3">{a.excerpt}</p>
                <a href={`/actualites/${a.slug}`} class="text-gold font-semibold text-sm hover:underline">Lire l'article →</a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>

<script define:vars={{ apiUrl }}>
document.addEventListener('DOMContentLoaded', () => {
  const buttons = document.querySelectorAll('[data-filter]');
  const articles = document.querySelectorAll('[data-category]');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => { b.className = b.className.replace('bg-navy text-white', 'bg-offwhite text-gray-500 hover:bg-navy/10'); });
      btn.className = btn.className.replace('bg-offwhite text-gray-500 hover:bg-navy/10', 'bg-navy text-white');
      const filter = btn.dataset.filter;
      articles.forEach(a => {
        a.style.display = (filter === 'Tous' || a.dataset.category === filter) ? '' : 'none';
      });
    });
  });

  document.getElementById('newsletterForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(e.target).get('email');
    const msg = document.getElementById('newsletter-msg');
    const res = await fetch(`${apiUrl}/api/newsletter`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    if (msg) {
      msg.textContent = res.ok ? 'Merci pour votre inscription !' : 'Erreur, réessayez plus tard.';
      msg.className = `text-sm ${res.ok ? 'text-green-600' : 'text-red-500'}`;
      msg.classList.remove('hidden');
    }
  });
});
</script>
