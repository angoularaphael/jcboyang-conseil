---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { heroMedia } from '../data/hero-media';
import { marked } from 'marked';
import { sanitizeHtml } from '../lib/sanitize-html';

import { apiUrl as API_URL } from '../data/site-config';

// Configure marked — only inline-safe subset (no HTML passthrough)
marked.setOptions({ breaks: true });

type VitrineResource = {
  id: string;
  title: string;
  desc: string;
  descHtml: string;
  category: string;
  pages: string;
  icon: string;
};

const defaultIcon = 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z|M14 2v6h6';

const categoryIcons: Record<string, string> = {
  // Bibliothèque JCBO-CONSEIL® — nouvelles catégories
  'Les Cahiers': 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20|M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15z',
  'Les Livres Blancs': 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z|M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z',
  'Les Collections': 'M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z|M16 3H8|M12 3v4',
  'Les livres': 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  'À venir': 'M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  // Catégories classiques
  Guide: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2|M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2|M9 14l2 2 4-4',
  Modèle: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2|M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2|M9 12h6|M9 16h6',
  Outil: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  Vidéo: 'M23 7l-7 5 7 5V7z|M1 5h15a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H1a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z',
  Autre: defaultIcon,
};

// Ordre d'affichage des catégories sur la vitrine
const CATEGORY_ORDER = [
  'Les Cahiers',
  'Les Livres Blancs',
  'Les Collections',
  'Les livres',
  'À venir',
  'Guide',
  'Modèle',
  'Outil',
  'Vidéo',
  'Autre',
];

let resources: VitrineResource[] = [];

try {
  const res = await fetch(`${API_URL}/api/public/ressources`, { headers: { Accept: 'application/json' } });
  if (res.ok) {
    const data = (await res.json()) as {
      ressources?: { id: string; titre: string; description?: string; categorie: string; nom_fichier?: string }[];
    };
    resources = await Promise.all((data.ressources ?? []).map(async (r) => {
      const rawDesc = r.description || 'Ressource gratuite JCBO Conseil.';
      const descHtml = sanitizeHtml(String(await marked.parse(rawDesc)));
      return {
        id: r.id,
        title: r.titre,
        desc: rawDesc,
        descHtml,
        category: r.categorie,
        pages: r.nom_fichier?.toLowerCase().endsWith('.pdf') ? 'PDF' : 'Document',
        icon: categoryIcons[r.categorie] ?? defaultIcon,
      };
    }));
  }
} catch {
  /* liste vide si API indisponible */
}

// Grouper par catégorie, dans l'ordre défini
const grouped: { category: string; items: VitrineResource[] }[] = [];
for (const cat of CATEGORY_ORDER) {
  const items = resources.filter((r) => r.category === cat);
  if (items.length > 0) grouped.push({ category: cat, items });
}
// Catégories non prévues dans l'ordre
const knownCats = new Set(CATEGORY_ORDER);
const otherItems = resources.filter((r) => !knownCats.has(r.category));
if (otherItems.length > 0) grouped.push({ category: 'Autres', items: otherItems });
---
<Layout title="Bibliothèque JCBO-CONSEIL® — Ressources & Documents" description="Explorez la Bibliothèque JCBO-CONSEIL® : Cahiers, Livres Blancs, Collections et Livres de Jean-Christophe Boyang-Tsang. Téléchargement gratuit.">
  <Header />
  <div class="pt-24"></div>

  <PageHero imageSrc={heroMedia.ressources.image} imageAlt={heroMedia.ressources.alt}>
    <div class="max-w-[800px] mx-auto px-6">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-3">Documents & Publications</span>
      <h1 class="font-heading text-[clamp(1.8rem,4vw,2.8rem)] font-bold mb-4">Bibliothèque <span class="text-gold">JCBO-CONSEIL®</span></h1>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
      <p class="text-white/60">Cahiers, Livres Blancs, Collections et Livres — ressources concrètes pour votre développement. Téléchargement gratuit.</p>
    </div>
  </PageHero>

  <section class="py-16 bg-offwhite">
    <div class="max-w-[1200px] mx-auto px-6">
      {resources.length === 0 ? (
        <div class="text-center py-16 bg-white rounded-2xl border border-gold/10">
          <p class="text-navy font-semibold mb-2">Aucune ressource publiée pour le moment</p>
          <p class="text-gray-500 text-sm">L'administrateur peut ajouter des ressources depuis le dashboard → Ressources, avec « Afficher sur la vitrine » coché.</p>
        </div>
      ) : (
        <div class="space-y-14">
          {grouped.map(({ category, items }) => (
            <div>
              <div class="flex items-center gap-4 mb-8">
                <div class="w-10 h-10 bg-navy rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2">{(categoryIcons[category] ?? defaultIcon).split('|').map(d => <path d={d} />)}</svg>
                </div>
                <h2 class="font-heading text-xl font-bold text-navy">{category}</h2>
                <div class="flex-1 h-px bg-gold/15"></div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {items.map((r) => (
                  <div class="bg-white rounded-2xl border border-gold/10 p-7 hover:-translate-y-1 hover:shadow-lg transition-all group">
                    <div class="flex items-start gap-4 mb-5">
                      <div class="flex-shrink-0 w-14 h-14 bg-navy rounded-2xl flex items-center justify-center">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2">{r.icon.split('|').map(d => <path d={d} />)}</svg>
                      </div>
                      <div>
                        <span class="text-xs font-medium bg-gold/10 text-gold-dark px-3 py-1 rounded-full">{r.category}</span>
                        <p class="text-xs text-gray-400 mt-1">{r.pages}</p>
                      </div>
                    </div>
                    <h3 class="font-heading text-lg font-bold text-navy mb-2 group-hover:text-gold transition-colors">{r.title}</h3>
                    <div class="prose prose-sm prose-gray max-w-none mb-6 text-gray-500 leading-relaxed [&_a]:text-gold [&_a]:underline [&_strong]:text-navy" set:html={r.descHtml}></div>
                    <button
                      class="download-btn w-full flex items-center justify-center gap-2 bg-navy text-white font-bold py-3 rounded-xl hover:bg-gold hover:text-navy transition-all"
                      data-resource={r.title}
                      data-resource-id={r.id}
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                      Télécharger gratuitement
                    </button>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <div id="downloadModal" class="fixed inset-0 z-[2000] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 invisible transition-all duration-300">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full relative shadow-2xl">
      <button id="closeModal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-offwhite flex items-center justify-center text-gray-400 hover:text-navy transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div id="downloadFormView">
        <div class="w-14 h-14 bg-gold/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-navy text-center mb-2">Téléchargement gratuit</h3>
        <p class="text-gray-500 text-sm text-center mb-1" id="modal-resource-name">—</p>
        <p class="text-gray-400 text-xs text-center mb-6">Le document vous sera envoyé par e-mail en pièce jointe.</p>
        <form id="downloadForm" class="space-y-4">
        <input type="hidden" name="dl-resource-id" id="dl-resource-id" value="" />
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-navy mb-1.5">Nom <span class="text-red-500">*</span></label>
            <input type="text" name="dl-nom" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none text-sm" placeholder="Dupont" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-navy mb-1.5">Prénom <span class="text-red-500">*</span></label>
            <input type="text" name="dl-prenom" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none text-sm" placeholder="Jean-Christophe" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-navy mb-1.5">Email professionnel <span class="text-red-500">*</span></label>
          <input type="email" name="dl-email" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none text-sm" placeholder="email@entreprise.com" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-navy mb-1.5">Profession <span class="text-red-500">*</span></label>
          <input type="text" name="dl-profession" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none text-sm" placeholder="Dirigeant, Consultant, etc." />
        </div>
        <label class="flex items-start gap-2">
          <input type="checkbox" name="dl-newsletter" checked class="w-4 h-4 mt-0.5 accent-[#d4a762]" />
          <span class="text-xs text-gray-500">J'accepte de recevoir les conseils et actualités de JCBO Conseil</span>
        </label>
        <p id="downloadError" class="hidden text-sm text-red-600 text-center"></p>
        <button type="submit" class="w-full bg-gold text-navy font-bold py-3.5 rounded-full hover:bg-gold-light transition-all">
          Recevoir le document par e-mail
        </button>
        </form>
        <p class="text-xs text-gray-400 text-center mt-4">Vos données sont protégées. Pas de spam, désinscription en 1 clic.</p>
      </div>
      <div id="downloadSuccessView" class="hidden text-center py-2">
        <div class="w-14 h-14 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-5">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-navy mb-2">C'est envoyé !</h3>
        <p class="text-gray-500 text-sm mb-1">Consultez votre boîte e-mail pour récupérer le document.</p>
        <p class="text-gray-400 text-xs mb-6" id="downloadSuccessEmail"></p>
        <button type="button" id="downloadSuccessClose" class="w-full bg-navy text-white font-bold py-3.5 rounded-full hover:bg-navy/90 transition-all">
          Fermer
        </button>
      </div>
    </div>
  </div>

  <section class="py-14 bg-navy text-center">
    <div class="max-w-[700px] mx-auto px-6">
      <h2 class="font-heading text-2xl font-bold text-white mb-4">Besoin d'un accompagnement <span class="text-gold">personnalisé</span> ?</h2>
      <p class="text-white/50 mb-8">Nos ressources gratuites sont un bon début. Pour aller plus loin, réservez une séance.</p>
      <div class="flex items-center justify-center gap-4 flex-wrap">
        <a href="/reserver" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3.5 px-8 rounded-full hover:bg-gold-light transition-all">Réserver une séance</a>
        <a href="/prestations" class="inline-flex items-center gap-2 border border-white/30 text-white font-bold py-3.5 px-8 rounded-full hover:border-gold hover:text-gold transition-all">Nos prestations</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import '../scripts/ressources-modal.ts';
</script>
