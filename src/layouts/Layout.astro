---
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const currentUrl = new URL(Astro.url.pathname, 'https://jcbo-conseil.com').href;

// JSON-LD AEO & SEO Structure
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "JCBO Conseil",
  "founder": {
    "@type": "Person",
    "name": "Jean-Christophe Boyang-Tsang",
    "jobTitle": "Consultant Expert en Business Development"
  },
  "description": "Expert en stratégie commerciale et marketing avec plus de 30 ans d'expérience. Conseil, formations et coaching pour PME/TPE à Toulouse et à l'international.",
  "url": "https://jcbo-conseil.com",
  "logo": "https://jcbo-conseil.com/images/logo.png",
  "image": "https://jcbo-conseil.com/images/2022/IMG-20240503-WA0065.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Toulouse",
    "addressRegion": "Occitanie",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "43.6047",
    "longitude": "1.4442"
  },
  "areaServed": ["Toulouse", "France", "International"],
  "priceRange": "$$",
  "knowsAbout": ["Business Development", "Sales Training", "Coaching Dirigeant", "Stratégie Commerciale", "Mindset Entrepreneurial"]
};
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="JCBO Conseil, conseil stratégie commerciale Toulouse, formation vente entreprise, coaching dirigeant PME, business development, Jean-Christophe Boyang-Tsang, audit commercial gratuit, formation leadership, accompagnement croissance" />
  <meta name="author" content="Jean-Christophe Boyang-Tsang - JCBO Conseil" />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large"} />
  <link rel="canonical" href={currentUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://jcbo-conseil.com/images/logo.png" />
  <meta property="og:image:alt" content="Logo JCBO Conseil" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="JCBO Conseil" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://jcbo-conseil.com/images/logo.png" />

  <meta name="geo.region" content="FR-OCC" />
  <meta name="geo.placename" content="Toulouse" />
  <meta name="geo.position" content="43.6047;1.4442" />
  <meta name="ICBM" content="43.6047, 1.4442" />

  <!-- AEO / SEO Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="apple-touch-icon" href="/images/logo.png" />
</head>
<body class="font-body text-gray-800 bg-white overflow-x-hidden">
  <slot />
  <CookieBanner />

  <script src="../scripts/main.js"></script>
</body>
</html>
