{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/a-propos\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/actualites\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/actualites\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/faq\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/mentions-legales\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/methode\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/offres\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/prestations\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/reserver\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/ressources\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/resultats\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/seminaires\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}