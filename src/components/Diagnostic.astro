---
---
<section class="py-20 md:py-28 bg-navy text-white" id="diagnostic">
  <div class="max-w-[900px] mx-auto px-6">
    <div class="text-center mb-12" data-animate="fade-up">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Passez à l'action</span>
      <h2 class="font-heading text-[clamp(1.8rem,4vw,2.8rem)] font-bold text-white mb-4">Demandez votre <span class="text-gold">audit gratuit</span></h2>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
      <p class="text-white/50 max-w-lg mx-auto">30 minutes pour identifier vos leviers de croissance. Gratuit, sans engagement, 100% actionnable.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-10">
      <!-- Left: value props -->
      <div data-animate="fade-right">
        <h3 class="font-heading text-xl font-semibold text-gold mb-6">Ce que vous obtenez :</h3>
        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-green-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span class="text-white/70 text-sm">Diagnostic flash de votre situation commerciale</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-green-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span class="text-white/70 text-sm">Identification de vos 3 leviers de croissance prioritaires</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-green-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span class="text-white/70 text-sm">Premières recommandations actionnables immédiatement</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-green-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span class="text-white/70 text-sm">Plan de route personnalisé si on travaille ensemble</span>
          </li>
        </ul>

        <div class="bg-navy-light border border-gold/15 rounded-xl p-5">
          <p class="text-white/40 text-xs uppercase tracking-wider mb-2">Coordonnées directes</p>
          <p class="text-sm text-white/70 mb-1"><a href="tel:+33615630938" class="text-gold hover:text-gold-light transition-colors">+33 6 15 63 09 38</a> (France)</p>
          <p class="text-sm text-white/70 mb-1"><a href="tel:+237695886559" class="text-gold hover:text-gold-light transition-colors">+237 6 95 88 65 59</a> (Cameroun)</p>
          <p class="text-sm text-white/70"><a href="mailto:contact@jcbo-conseil.com" class="text-gold hover:text-gold-light transition-colors">contact@jcbo-conseil.com</a></p>
          <div class="flex gap-3 mt-4">
            <a href="https://www.facebook.com/profile.php?id=61553882894803" target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 rounded-full border border-gold/20 flex items-center justify-center text-gold hover:bg-gold hover:text-navy transition-all">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/jean-christophe-boyang-tsang-business-b16a08a6/" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-9 h-9 rounded-full border border-gold/20 flex items-center justify-center text-gold hover:bg-gold hover:text-navy transition-all">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: form -->
      <div class="bg-white rounded-2xl p-7 md:p-9 text-gray-800" data-animate="fade-left">
        <form id="contactForm" novalidate>
          <div class="mb-4">
            <label for="name" class="block text-xs font-semibold text-navy mb-1.5">Nom complet *</label>
            <input type="text" id="name" name="name" required placeholder="Jean Dupont" class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10 transition-all" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="email" class="block text-xs font-semibold text-navy mb-1.5">Email *</label>
              <input type="email" id="email" name="email" required placeholder="jean@entreprise.com" class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10 transition-all" />
            </div>
            <div>
              <label for="phone" class="block text-xs font-semibold text-navy mb-1.5">Téléphone *</label>
              <input type="tel" id="phone" name="phone" required placeholder="+33 6 XX XX XX XX" class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10 transition-all" />
            </div>
          </div>
          <div class="mb-4">
            <label for="company" class="block text-xs font-semibold text-navy mb-1.5">Entreprise & poste</label>
            <input type="text" id="company" name="company" placeholder="Nom de votre entreprise — Votre fonction" class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10 transition-all" />
          </div>
          <div class="mb-4">
            <label for="need" class="block text-xs font-semibold text-navy mb-1.5">Votre besoin principal</label>
            <select id="need" name="need" class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10 transition-all appearance-none bg-[url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23999%22%20stroke-width%3D%222%22%3E%3Cpath%20d%3D%22M6%209l6%206%206-6%22/%3E%3C/svg%3E')] bg-no-repeat bg-[right_1rem_center]">
              <option value="">Sélectionnez...</option>
              <option value="strategie">Structurer ma stratégie commerciale</option>
              <option value="vente">Augmenter mes ventes / mon CA</option>
              <option value="equipe">Former mes équipes commerciales</option>
              <option value="coaching">Être coaché en tant que dirigeant</option>
              <option value="international">Développer à l'international</option>
              <option value="autre">Autre besoin</option>
            </select>
          </div>
          <div class="mb-6">
            <label for="message" class="block text-xs font-semibold text-navy mb-1.5">Décrivez brièvement votre situation</label>
            <textarea id="message" name="message" rows="3" placeholder="Quel est votre principal défi commercial actuellement ?" class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10 transition-all resize-y"></textarea>
          </div>
          <button type="submit" class="w-full flex items-center justify-center gap-2 bg-gold text-navy font-bold py-4 rounded-full hover:bg-gold-light transition-all text-[0.95rem]">
            <span>Réserver mon audit gratuit</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
          <p class="text-center text-[0.65rem] text-gray-400 mt-3">Vos données sont protégées. Aucun spam. Réponse sous 24h.</p>
        </form>
      </div>
    </div>
  </div>
</section>
