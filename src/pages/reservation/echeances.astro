---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { bankDetails, formatIbanDisplay } from '../../data/bank-details';

const planId = Astro.url.searchParams.get('plan') ?? '';
const planToken = Astro.url.searchParams.get('token') ?? '';
---
<Layout
  title="Paiement en plusieurs fois — JCBO Conseil"
  description="Suivez et réglez les échéances de votre réservation JCBO Conseil."
  noindex
>
  <Header />
  <div class="pt-24"></div>

  <section class="py-16 bg-offwhite min-h-[60vh]">
    <div class="max-w-[640px] mx-auto px-6">
      {!planId ? (
        <div class="bg-white rounded-2xl p-8 border border-gold/10 text-center">
          <p class="text-gray-500">Lien de paiement invalide. Vérifiez l'e-mail reçu après votre première échéance.</p>
        </div>
      ) : (
        <div class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm">
          <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Échéances</span>
          <h1 class="font-heading text-2xl font-bold text-navy mb-2">Paiement en plusieurs fois</h1>
          <p id="plan-loading" class="text-sm text-gray-400 mb-6">Chargement du plan de paiement…</p>

          <div id="plan-content" class="hidden">
            <p class="text-sm text-gray-500 mb-4" id="plan-session"></p>

            <div class="bg-offwhite rounded-xl p-5 mb-6">
              <p class="text-xs font-bold uppercase tracking-wider text-gold-dark mb-3">Progression</p>
              <div class="flex items-center justify-between text-sm mb-2">
                <span class="text-gray-500">Échéances payées</span>
                <span class="font-bold text-navy" id="plan-progress">—</span>
              </div>
              <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
                <div id="plan-progress-bar" class="h-full bg-gold transition-all duration-500" style="width:0%"></div>
              </div>
              <p class="text-xs text-gray-400 mt-3" id="plan-total"></p>
            </div>

            <div id="plan-next-block">
              <p class="text-sm text-gray-600 mb-4" id="plan-next-text"></p>
              <div class="bg-navy/5 border border-gold/20 rounded-xl p-5 text-sm text-gray-600">
                <p class="font-semibold text-navy mb-2">Régler votre échéance</p>
                <p class="mb-3">
                  Effectuez un virement bancaire du montant indiqué ci-dessus en précisant la référence
                  <strong id="plan-ref-display" class="text-navy"></strong> dans le libellé du virement.
                </p>
                <p class="text-xs text-gray-500 mb-1">Titulaire : {bankDetails.holder}</p>
                <p class="text-xs text-gray-500 mb-1">IBAN : {formatIbanDisplay(bankDetails.iban)}</p>
                <p class="text-xs text-gray-500 mb-4">BIC : {bankDetails.bic}</p>
                <p class="text-xs text-gray-400">
                  Une question ? Écrivez-nous à
                  <a href="mailto:contact@jcbo-conseil.com" class="text-gold hover:underline">contact@jcbo-conseil.com</a>
                  en indiquant votre référence de plan.
                </p>
              </div>
            </div>

            <div id="plan-complete-block" class="hidden text-center">
              <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-green-50 flex items-center justify-center">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <p class="font-semibold text-navy mb-2">Toutes les échéances sont payées</p>
              <p class="text-sm text-gray-500 mb-6">Votre réservation est confirmée. Consultez votre e-mail pour la facture complète.</p>
              <a href="/" class="inline-flex bg-gold text-navy font-bold py-3 px-8 rounded-full hover:bg-gold-light transition-all">Accueil</a>
            </div>
          </div>

          <p id="plan-error" class="hidden text-sm text-red-600"></p>
        </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>

{planId && (
  <script define:vars={{ planId, planToken }}>
    const loadingEl = document.getElementById("plan-loading");
    const contentEl = document.getElementById("plan-content");
    const errorEl = document.getElementById("plan-error");

    function formatXaf(n) {
      return `${Math.round(n).toLocaleString("fr-FR")} FCFA`;
    }

    async function loadPlan() {
      try {
        const res = await fetch(
          `/api/installment-plan?plan=${encodeURIComponent(planId)}&token=${encodeURIComponent(planToken)}`,
          { cache: "no-store" }
        );
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Plan introuvable");

        loadingEl?.classList.add("hidden");
        contentEl?.classList.remove("hidden");

        const sessionEl = document.getElementById("plan-session");
        const progressEl = document.getElementById("plan-progress");
        const barEl = document.getElementById("plan-progress-bar");
        const totalEl = document.getElementById("plan-total");
        const nextTextEl = document.getElementById("plan-next-text");
        const nextBlock = document.getElementById("plan-next-block");
        const completeBlock = document.getElementById("plan-complete-block");
        const refDisplay = document.getElementById("plan-ref-display");

        if (sessionEl) sessionEl.textContent = `Prestation : ${data.sessionLabel}`;
        if (progressEl) progressEl.textContent = `${data.paidCount} / ${data.totalInstallments}`;
        if (barEl) barEl.style.width = `${(data.paidCount / data.totalInstallments) * 100}%`;
        if (totalEl) {
          const collected = data.collectedXaf ?? 0;
          totalEl.textContent =
            `Montant total : ${formatXaf(data.totalXaf)}` +
            (collected > 0 ? ` — déjà reçu : ${formatXaf(collected)}` : "");
        }
        if (refDisplay) refDisplay.textContent = data.id || planId;

        if (data.complete) {
          nextBlock?.classList.add("hidden");
          completeBlock?.classList.remove("hidden");
        } else if (nextTextEl) {
          nextTextEl.textContent =
            `Prochaine étape : régler l'échéance ${data.nextInstallmentNumber} sur ${data.totalInstallments} ` +
            `(${formatXaf(data.nextInstallmentAmount)}).`;
        }
      } catch (err) {
        loadingEl?.classList.add("hidden");
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : "Erreur de chargement";
          errorEl.classList.remove("hidden");
        }
      }
    }

    loadPlan();
  </script>
)}
