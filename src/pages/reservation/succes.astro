---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  pickNotchpayTrxIdFromUrl,
  pickVitrineReferenceFromUrl,
} from '../../lib/notchpay-reference';

const sessionId = Astro.url.searchParams.get('session_id') ?? '';
const provider = Astro.url.searchParams.get('provider') ?? '';
const notchReference =
  provider === 'notchpay'
    ? pickVitrineReferenceFromUrl(Astro.url.searchParams)
    : Astro.url.searchParams.get('reference') ?? Astro.url.searchParams.get('trxref') ?? '';
const notchTrxId = provider === 'notchpay' ? pickNotchpayTrxIdFromUrl(Astro.url.searchParams) : '';
const paymentRef = provider === 'notchpay' ? notchReference : sessionId;
const factureParam = provider === 'notchpay' ? 'reference' : 'session_id';
const factureId = provider === 'notchpay' ? notchReference : sessionId;
const factureHref =
  factureId && provider
    ? `/api/reservation/facture?provider=${encodeURIComponent(provider)}&${factureParam}=${encodeURIComponent(factureId)}`
    : factureId
      ? `/api/reservation/facture?provider=stripe&session_id=${encodeURIComponent(factureId)}`
      : '';
const shouldVerify = !!(sessionId || provider === 'notchpay');
---
<Layout title="Paiement confirmé — JCBO Conseil" description="Votre réservation est confirmée. Notre équipe vous recontactera très rapidement." noindex>
  <Header />
  <div class="pt-24"></div>

  <section class="py-20 bg-offwhite">
    <div class="max-w-[720px] mx-auto px-6">
      {shouldVerify && (
        <div id="verify-loading" class="bg-white rounded-2xl p-10 text-center border border-gold/10 shadow-sm">
          <div class="w-12 h-12 mx-auto mb-4 border-2 border-gold border-t-transparent rounded-full animate-spin"></div>
          <p class="text-gray-500" id="verify-loading-text">Vérification du paiement en cours…</p>
        </div>
      )}

      <div id="success-card" class:list={["bg-white rounded-2xl p-10 text-center border border-gold/10 shadow-sm", shouldVerify && "hidden"]}>
        <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center bg-green-50" id="success-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Merci</span>
        <h1 class="font-heading text-3xl font-bold text-navy mb-3" id="success-title">Paiement <span class="text-gold">confirmé</span></h1>
        <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
        <p class="text-gray-500 mb-4 leading-relaxed" id="success-message">
          Votre réservation a bien été enregistrée. Votre <strong class="text-navy">facture</strong> vous sera envoyée par e-mail dans quelques instants (vérifiez aussi les spams).
          L'équipe JCBO Conseil vous recontactera très rapidement pour planifier votre séance.
        </p>

        <div id="installment-block" class="hidden text-left bg-amber-50 border border-amber-200 rounded-xl p-6 mb-6">
          <p class="text-sm font-bold text-navy mb-2" id="installment-progress"></p>
          <p class="text-sm text-amber-900 mb-4" id="installment-next"></p>
          <button
            type="button"
            id="installment-pay-btn"
            class="inline-flex w-full justify-center items-center gap-2 bg-gold text-navy font-bold py-3 px-6 rounded-full hover:bg-gold-light transition-all disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Payer l'échéance suivante
          </button>
        </div>

        <p id="invoice-status" class="text-sm text-gold-dark mb-4 hidden" role="status"></p>
        <a
          id="facture-link"
          href={factureHref}
          target="_blank"
          rel="noopener noreferrer"
          class:list={["inline-flex items-center gap-2 border-2 border-gold text-navy font-bold py-3 px-8 rounded-full hover:bg-gold/10 transition-all mb-4", !factureHref && "hidden"]}
        >
          Voir ma facture
        </a>
        {paymentRef && (
          <p class="text-xs text-gray-400 mb-8">Référence paiement : <code class="font-mono">{paymentRef}</code></p>
        )}
        <a href="/" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3 px-8 rounded-full hover:bg-gold-light transition-all">
          Retour à l'accueil
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

{shouldVerify && (
  <script define:vars={{ sessionId, provider, notchReference, notchTrxId }}>
    function formatXaf(n) {
      return `${Math.round(n).toLocaleString("fr-FR")} FCFA`;
    }

    function redirectToFailure(data, paymentRef) {
      const params = new URLSearchParams({
        provider: provider || "stripe",
        status: data.paymentStatus || "failed",
        msg: data.statusMessage || data.error || "Paiement non finalisé.",
      });
      if (paymentRef) params.set("reference", paymentRef);
      window.location.replace(`/reservation/echec?${params}`);
    }

    function showSuccessCard() {
      document.getElementById("verify-loading")?.classList.add("hidden");
      document.getElementById("success-card")?.classList.remove("hidden");
    }

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    function isFinalFailure(data) {
      return ["failed", "canceled", "expired", "unpaid"].includes(data.paymentStatus);
    }

    function shouldRetryVerification(data) {
      return (
        data.retryable ||
        data.paymentStatus === "pending" ||
        data.paymentStatus === "processing" ||
        data.paymentStatus === "unknown"
      );
    }

    async function startInstallmentCheckout(planId) {
      const payBtn = document.getElementById("installment-pay-btn");
      if (!(payBtn instanceof HTMLButtonElement) || !planId) return;

      payBtn.disabled = true;
      payBtn.textContent = "Redirection vers NotchPay…";

      try {
        const planRes = await fetch(`/api/installment-plan?plan=${encodeURIComponent(planId)}`, {
          cache: "no-store",
        });
        const plan = await planRes.json();
        if (!planRes.ok || plan.complete) {
          throw new Error(plan.error || "Plan introuvable");
        }

        const checkoutRes = await fetch("/api/notchpay/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            planId: plan.id,
            sessionId: plan.sessionId,
            name: plan.customerName,
            email: plan.customerEmail,
            phone: plan.customerPhone,
          }),
        });
        const checkout = await checkoutRes.json();
        if (!checkoutRes.ok || !checkout.url) {
          throw new Error(checkout.error || "Impossible de lancer le paiement.");
        }
        window.location.href = checkout.url;
      } catch (err) {
        payBtn.disabled = false;
        payBtn.textContent = "Payer l'échéance suivante";
        alert(err instanceof Error ? err.message : "Impossible de lancer le paiement.");
      }
    }

    function applySuccessUi(data) {
      const statusEl = document.getElementById("invoice-status");
      const factureLink = document.getElementById("facture-link");
      const installmentBlock = document.getElementById("installment-block");
      const successMessage = document.getElementById("success-message");
      const successTitle = document.getElementById("success-title");

      showSuccessCard();

      if (data.installment) {
          const inst = data.installment;
          if (inst.complete) {
            if (successTitle) successTitle.innerHTML = 'Réservation <span class="text-gold">confirmée</span>';
            if (successMessage) {
              successMessage.innerHTML =
                "Les <strong class=\"text-navy\">3 échéances</strong> ont été réglées. Votre facture complète vous est envoyée par e-mail. L'équipe JCBO vous recontactera pour planifier votre séance.";
            }
            if (statusEl && data.emailSent) {
              statusEl.textContent = "Facture complète envoyée par e-mail.";
              statusEl.classList.remove("hidden");
            }
          } else {
            if (successTitle) successTitle.innerHTML = `Échéance <span class="text-gold">${inst.paidCount}/${inst.totalInstallments}</span> reçue`;
            if (successMessage) {
              successMessage.textContent =
                "Merci ! Votre paiement a bien été enregistré. Un e-mail de confirmation vient de vous être envoyé avec le lien pour la prochaine étape.";
            }
            if (installmentBlock) installmentBlock.classList.remove("hidden");
            const progressEl = document.getElementById("installment-progress");
            const nextEl = document.getElementById("installment-next");
            const payBtn = document.getElementById("installment-pay-btn");
            if (progressEl) {
              progressEl.textContent = `Progression : ${inst.paidCount} sur ${inst.totalInstallments} échéances payées`;
            }
            if (nextEl && inst.nextInstallmentNumber) {
              nextEl.textContent =
                `Prochaine étape : payer l'échéance ${inst.nextInstallmentNumber}` +
                (inst.nextInstallmentAmount ? ` (${formatXaf(inst.nextInstallmentAmount)})` : "") +
                " pour finaliser votre réservation.";
            }
            if (payBtn instanceof HTMLButtonElement && inst.planId) {
              payBtn.disabled = false;
              payBtn.onclick = () => startInstallmentCheckout(inst.planId);
            }
            if (factureLink) factureLink.classList.add("hidden");
            if (statusEl && data.emailSent) {
              statusEl.textContent = "E-mail de suivi envoyé avec le lien de la prochaine échéance.";
              statusEl.classList.remove("hidden");
            }
          }
        } else if (statusEl && data.ok && data.emailSent) {
          statusEl.textContent = "Votre facture a été envoyée à votre adresse e-mail.";
          statusEl.classList.remove("hidden");
        }

      if (data.factureUrl && factureLink instanceof HTMLAnchorElement) {
        if (!data.installment || data.installment.complete) {
          factureLink.href = data.factureUrl;
          factureLink.classList.remove("hidden");
        }
      }
    }

    function buildNotchpayApiQuery() {
      const params = new URLSearchParams();
      if (notchReference) params.set("ref", notchReference);
      if (notchTrxId) params.set("trx", notchTrxId);
      if (!notchReference && notchTrxId) params.set("reference", notchTrxId);
      return params.toString();
    }

    async function verifyNotchpayPayment(paymentRef, loadingText) {
      if (!paymentRef && !notchTrxId) {
        redirectToFailure(
          { statusMessage: "Référence de paiement introuvable. Le paiement n'a pas pu être vérifié." },
          paymentRef
        );
        return;
      }

      const query = buildNotchpayApiQuery();
      const statusUrl = `/api/notchpay/payment-status?${query}`;
      const fulfillUrl = `/api/notchpay/fulfill?${query}`;
      const maxAttempts = 12;

      for (let attempt = 0; attempt < maxAttempts; attempt++) {
        let data = {};
        try {
          const res = await fetch(statusUrl);
          data = await res.json();
        } catch {
          if (attempt < maxAttempts - 1) {
            await sleep(1500);
            continue;
          }
          redirectToFailure({ statusMessage: "Impossible de vérifier le paiement." }, paymentRef);
          return;
        }

        if (data.ok && (data.fulfilled || data.installment)) {
          applySuccessUi(data);
          return;
        }

        if (isFinalFailure(data)) {
          redirectToFailure(data, paymentRef);
          return;
        }

        if (data.needsFulfill && data.ok) {
          try {
            const fulfillRes = await fetch(fulfillUrl, { method: "POST" });
            const fulfillData = await fulfillRes.json();
            if (fulfillData.ok) {
              applySuccessUi(fulfillData);
              return;
            }
            if (isFinalFailure(fulfillData)) {
              redirectToFailure(fulfillData, paymentRef);
              return;
            }
            data = fulfillData;
          } catch {
            if (attempt < maxAttempts - 1) {
              await sleep(1500);
              continue;
            }
            redirectToFailure({ statusMessage: "Erreur réseau lors de la confirmation." }, paymentRef);
            return;
          }
        }

        if (shouldRetryVerification(data) && attempt < maxAttempts - 1) {
          if (loadingText) {
            loadingText.textContent =
              data.statusMessage || "Vérification du paiement Mobile Money en cours…";
          }
          await sleep(1500);
          continue;
        }

        redirectToFailure(data, paymentRef);
        return;
      }

      redirectToFailure(
        {
          paymentStatus: "failed",
          statusMessage:
            "Paiement non confirmé. Aucun montant n'a été débité. Si vous pensez qu'il s'agit d'une erreur, contactez-nous.",
        },
        paymentRef
      );
    }

    async function verifyStripePayment(paymentRef, loadingText) {
      const verifyUrl = `/api/stripe/fulfill?session_id=${encodeURIComponent(sessionId)}`;
      const maxAttempts = 4;

      for (let attempt = 0; attempt < maxAttempts; attempt++) {
        let data = {};
        try {
          const res = await fetch(verifyUrl, { method: "POST" });
          data = await res.json();
        } catch {
          if (attempt < maxAttempts - 1) {
            await sleep(1500);
            continue;
          }
          redirectToFailure({ statusMessage: "Impossible de vérifier le paiement." }, paymentRef);
          return;
        }

        if (data.ok) {
          applySuccessUi(data);
          return;
        }

        if (isFinalFailure(data)) {
          redirectToFailure(data, paymentRef);
          return;
        }

        if (shouldRetryVerification(data) && attempt < maxAttempts - 1) {
          if (loadingText) {
            loadingText.textContent = data.statusMessage || "Vérification du paiement en cours…";
          }
          await sleep(1500);
          continue;
        }

        redirectToFailure(data, paymentRef);
        return;
      }

      redirectToFailure({ statusMessage: "Paiement non confirmé." }, paymentRef);
    }

    (async () => {
      const paymentRef = provider === "notchpay" ? notchReference : sessionId;
      const loadingText = document.getElementById("verify-loading-text");

      try {
        if (provider === "notchpay" && (notchReference || notchTrxId)) {
          await verifyNotchpayPayment(paymentRef, loadingText);
        } else {
          await verifyStripePayment(paymentRef, loadingText);
        }
      } catch {
        redirectToFailure({ statusMessage: "Erreur réseau lors de la vérification du paiement." }, paymentRef);
      }
    })();
  </script>
)}
