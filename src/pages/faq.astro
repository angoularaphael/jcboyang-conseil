---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="FAQ — JCBO Conseil | Questions Fréquentes" description="Retrouvez les réponses aux questions fréquentes sur nos services de conseil, coaching et formation.">
  <Header />
  <div class="pt-24"></div>
  <FAQ />

  <!-- CTA -->
  <section class="py-16 bg-offwhite text-center">
    <div class="max-w-[700px] mx-auto px-6">
      <h2 class="font-heading text-2xl font-bold text-navy mb-4">D'autres <span class="text-gold">questions</span> ?</h2>
      <p class="text-gray-500 mb-8">Notre équipe est à votre disposition pour répondre à toutes vos interrogations.</p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3.5 px-8 rounded-full hover:bg-gold-light transition-all">Être recontacté</a>
    </div>
  </section>

  <Footer />
</Layout>
