---
const navLinks = [
  { href: '#hero', label: 'Accueil' },
  { href: '#probleme', label: 'Le problème' },
  { href: '#methode', label: 'Méthode' },
  { href: '#offres', label: 'Offres' },
  { href: '#resultats', label: 'Résultats' },
  { href: '#faq', label: 'FAQ' },
];
---
<header id="header" class="fixed top-0 left-0 w-full z-[1002] py-4 transition-all duration-300 bg-transparent">
  <nav class="max-w-[1200px] mx-auto px-6 flex items-center justify-between">
    <a href="#hero" aria-label="JCBO Conseil" class="group z-[1002]">
      <svg viewBox="0 0 120 140" width="50" height="58">
        <rect x="5" y="5" width="110" height="130" rx="4" fill="none" stroke="#d4a762" stroke-width="2" class="transition-all group-hover:filter group-hover:drop-shadow-[0_0_8px_rgba(212,167,98,0.5)]"/>
        <text x="60" y="62" text-anchor="middle" font-family="'Playfair Display', serif" font-size="30" fill="#d4a762" font-weight="600">JC</text>
        <text x="60" y="95" text-anchor="middle" font-family="'Playfair Display', serif" font-size="30" fill="#d4a762" font-weight="600">BO</text>
        <text x="98" y="118" text-anchor="middle" font-family="'Cormorant Garamond', serif" font-size="14" fill="#d4a762" font-style="italic">Conseil</text>
      </svg>
    </a>
    <button id="navToggle" aria-label="Menu" aria-expanded="false" class="md:hidden flex flex-col gap-[5px] bg-none border-none p-2 z-[1002] relative">
      <span class="block w-6 h-0.5 bg-white rounded transition-all origin-center" id="burger1"></span>
      <span class="block w-6 h-0.5 bg-white rounded transition-all" id="burger2"></span>
      <span class="block w-6 h-0.5 bg-white rounded transition-all origin-center" id="burger3"></span>
    </button>
    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-2">
      {navLinks.map(link => (
        <li><a href={link.href} class="nav-link text-white text-[0.9rem] font-medium px-4 py-2 rounded-lg relative hover:text-gold-light transition-colors">{link.label}</a></li>
      ))}
      <li><a href="#diagnostic" class="bg-gold text-navy font-semibold rounded-full px-6 py-2.5 text-[0.9rem] hover:bg-gold-light hover:-translate-y-0.5 transition-all">Audit gratuit</a></li>
    </ul>
  </nav>
</header>

<!-- Mobile fullscreen overlay menu -->
<div id="mobileMenu" class="fixed inset-0 z-[1001] bg-navy flex flex-col items-center justify-center gap-1 transition-all duration-300 opacity-0 invisible md:hidden">
  {navLinks.map(link => (
    <a href={link.href} class="mobile-nav-link text-white text-xl font-heading font-semibold py-3 px-8 rounded-lg hover:text-gold transition-colors">{link.label}</a>
  ))}
  <a href="#diagnostic" class="mt-6 bg-gold text-navy font-bold rounded-full px-10 py-3.5 text-base hover:bg-gold-light transition-all">Audit gratuit</a>
  <div class="mt-10 flex gap-4">
    <a href="https://www.facebook.com/profile.php?id=61553882894803" target="_blank" rel="noopener" aria-label="Facebook" class="w-10 h-10 rounded-full border border-gold/30 flex items-center justify-center text-gold hover:bg-gold hover:text-navy transition-all">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
    </a>
    <a href="https://www.linkedin.com/in/jean-christophe-boyang-tsang-business-b16a08a6/" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-10 h-10 rounded-full border border-gold/30 flex items-center justify-center text-gold hover:bg-gold hover:text-navy transition-all">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
    </a>
  </div>
  <p class="mt-6 text-white/20 text-xs">+33 6 15 63 09 38 · jcboyang@gmail.com</p>
</div>

<!-- Sticky CTA mobile -->
<div id="stickyCta" class="fixed bottom-0 left-0 w-full bg-navy/95 backdrop-blur-lg border-t border-gold/20 p-3 z-[999] translate-y-full transition-transform duration-300 md:hidden">
  <a href="#diagnostic" class="flex items-center justify-center gap-2 bg-gold text-navy font-bold py-3 rounded-full text-sm animate-pulse-gold">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    Audit gratuit — Prendre RDV
  </a>
</div>
