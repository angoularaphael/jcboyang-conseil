<div id="cookie-banner" class="fixed bottom-0 inset-x-0 z-[1000] hidden" role="dialog" aria-label="Gestion des cookies">
  <div class="max-w-[1200px] mx-auto px-4 pb-4">
    <div class="bg-navy border border-gold/20 rounded-2xl shadow-2xl p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold text-white mb-1">Cookies & confidentialité</p>
        <p class="text-xs text-white/60 leading-relaxed">
          Nous utilisons des cookies techniques nécessaires au fonctionnement du site et, avec votre accord, des cookies de mesure d'audience.
          Consultez notre <a href="/mentions-legales#cookies" class="text-gold hover:underline">politique cookies</a>.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button type="button" id="cookie-refuse" class="px-4 py-2 rounded-lg text-xs font-medium border border-white/20 text-white/70 hover:text-white hover:border-white/40 transition">
          Refuser
        </button>
        <button type="button" id="cookie-accept" class="px-4 py-2 rounded-lg text-xs font-semibold bg-gold text-navy hover:bg-gold-light transition">
          Accepter
        </button>
      </div>
    </div>
  </div>
</div>
