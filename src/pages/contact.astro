---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { heroMedia } from '../data/hero-media';
---
<Layout title="Contact — JCBO Conseil | Être Recontacté" description="Contactez JCBO Conseil. Remplissez notre formulaire professionnel pour recevoir une réponse adaptée et orientée résultats.">
  <Header />
  <div class="pt-24"></div>

  <PageHero imageSrc={heroMedia.contact.image} imageAlt={heroMedia.contact.alt}>
    <div class="max-w-[800px] mx-auto px-6">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-3">Formulaire de contact</span>
      <h1 class="font-heading text-[clamp(1.8rem,4vw,2.8rem)] font-bold mb-4">Contactez <span class="text-gold">JCBO Conseil</span></h1>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
      <p class="text-white/60">Chaque demande est analysée avec rigueur afin de vous proposer une réponse adaptée, concrète et orientée résultats.</p>
      <p class="text-white/40 text-sm mt-3">Ce formulaire nous permet de comprendre votre situation et de vous orienter vers la solution la plus pertinente.</p>
    </div>
  </PageHero>

  <!-- Formulaire -->
  <section class="py-16 bg-offwhite">
    <div class="max-w-[800px] mx-auto px-6">
      <form id="contactForm" class="space-y-12">

        <!-- SECTION 1 -->
        <div class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-gold font-bold text-sm">1</span>
            <h2 class="font-heading text-xl font-bold text-navy">Informations personnelles</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-navy mb-1.5">Nom & Prénom <span class="text-red-500">*</span></label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" placeholder="Jean-Christophe Dupont" />
            </div>
            <div>
              <label for="fonction" class="block text-sm font-semibold text-navy mb-1.5">Fonction / Poste</label>
              <input type="text" id="fonction" name="fonction" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" placeholder="Directeur commercial" />
            </div>
            <div>
              <label for="entreprise" class="block text-sm font-semibold text-navy mb-1.5">Nom de l'entreprise / Projet</label>
              <input type="text" id="entreprise" name="entreprise" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" placeholder="Mon entreprise SAS" />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-navy mb-1.5">Email <span class="text-red-500">*</span></label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" placeholder="email@exemple.com" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-navy mb-1.5">Téléphone <span class="text-red-500">*</span></label>
              <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" placeholder="+33 6 00 00 00 00" />
            </div>
            <div>
              <label for="location" class="block text-sm font-semibold text-navy mb-1.5">Pays / Ville</label>
              <input type="text" id="location" name="location" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" placeholder="Toulouse, France" />
            </div>
          </div>
        </div>

        <!-- SECTION 2 -->
        <div class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-gold font-bold text-sm">2</span>
            <h2 class="font-heading text-xl font-bold text-navy">Votre situation actuelle</h2>
          </div>
          <div class="space-y-6">
            <div>
              <p class="text-sm font-semibold text-navy mb-3">Vous êtes :</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                {['Entrepreneur', 'Dirigeant PME', 'Business Developer', 'Porteur de projet'].map(opt => (
                  <label class="flex items-center gap-2.5 bg-offwhite rounded-xl px-4 py-3 cursor-pointer border border-transparent hover:border-gold/20 transition-all">
                    <input type="radio" name="profil" value={opt} class="w-4 h-4 text-gold accent-[#d4a762]" />
                    <span class="text-sm text-gray-700">{opt}</span>
                  </label>
                ))}
                <label class="flex items-center gap-2.5 bg-offwhite rounded-xl px-4 py-3 cursor-pointer border border-transparent hover:border-gold/20 transition-all col-span-1 sm:col-span-2 md:col-span-3">
                  <input type="radio" name="profil" value="autre" class="w-4 h-4 accent-[#d4a762]" />
                  <span class="text-sm text-gray-700">Autre :</span>
                  <input type="text" name="profil_autre" class="flex-1 border-b border-gray-300 bg-transparent outline-none text-sm px-2 py-0.5 focus:border-gold" placeholder="Précisez..." />
                </label>
              </div>
            </div>
            <div>
              <p class="text-sm font-semibold text-navy mb-3">Niveau d'activité :</p>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                {['Idée', 'Lancement', 'En croissance', 'En difficulté'].map(opt => (
                  <label class="flex items-center gap-2.5 bg-offwhite rounded-xl px-4 py-3 cursor-pointer border border-transparent hover:border-gold/20 transition-all">
                    <input type="radio" name="niveau" value={opt} class="w-4 h-4 accent-[#d4a762]" />
                    <span class="text-sm text-gray-700">{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 3 -->
        <div class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-gold font-bold text-sm">3</span>
            <h2 class="font-heading text-xl font-bold text-navy">Votre besoin</h2>
          </div>
          <p class="text-xs text-gold-dark font-medium mb-6 ml-11">Très important : première qualification de votre demande</p>
          <div class="space-y-6">
            <div>
              <p class="text-sm font-semibold text-navy mb-3">Objet de votre demande :</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                {['Coaching stratégique', 'Développement commercial', 'Structuration d\'offre', 'Mindset entrepreneurial', 'Formation'].map(opt => (
                  <label class="flex items-center gap-2.5 bg-offwhite rounded-xl px-4 py-3 cursor-pointer border border-transparent hover:border-gold/20 transition-all">
                    <input type="radio" name="objet" value={opt} class="w-4 h-4 accent-[#d4a762]" />
                    <span class="text-sm text-gray-700">{opt}</span>
                  </label>
                ))}
                <label class="flex items-center gap-2.5 bg-offwhite rounded-xl px-4 py-3 cursor-pointer border border-transparent hover:border-gold/20 transition-all">
                  <input type="radio" name="objet" value="autre" class="w-4 h-4 accent-[#d4a762]" />
                  <span class="text-sm text-gray-700">Autre :</span>
                  <input type="text" name="objet_autre" class="flex-1 border-b border-gray-300 bg-transparent outline-none text-sm px-2 py-0.5 focus:border-gold" placeholder="Précisez..." />
                </label>
              </div>
            </div>
            <div>
              <label for="besoin" class="block text-sm font-semibold text-navy mb-2">Décrivez votre besoin en quelques lignes :</label>
              <textarea id="besoin" name="besoin" rows="6" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm resize-y" placeholder="Décrivez votre situation actuelle, vos objectifs et ce que vous attendez de cet accompagnement..."></textarea>
            </div>
          </div>
        </div>

        <!-- SECTION 4 -->
        <div class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-gold font-bold text-sm">4</span>
            <h2 class="font-heading text-xl font-bold text-navy">Urgence & intention</h2>
          </div>
          <div class="space-y-6">
            <div>
              <p class="text-sm font-semibold text-navy mb-3">Votre besoin est :</p>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                {['Urgent', 'À court terme (1-3 mois)', 'À moyen terme'].map(opt => (
                  <label class="flex items-center gap-2.5 bg-offwhite rounded-xl px-4 py-3 cursor-pointer border border-transparent hover:border-gold/20 transition-all">
                    <input type="radio" name="urgence" value={opt} class="w-4 h-4 accent-[#d4a762]" />
                    <span class="text-sm text-gray-700">{opt}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <p class="text-sm font-semibold text-navy mb-3">Êtes-vous prêt à investir dans un accompagnement ?</p>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                {['Oui', 'Non', 'Je souhaite en discuter'].map(opt => (
                  <label class="flex items-center gap-2.5 bg-offwhite rounded-xl px-4 py-3 cursor-pointer border border-transparent hover:border-gold/20 transition-all">
                    <input type="radio" name="investissement" value={opt} class="w-4 h-4 accent-[#d4a762]" />
                    <span class="text-sm text-gray-700">{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 5 -->
        <div class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-gold font-bold text-sm">5</span>
            <h2 class="font-heading text-xl font-bold text-navy">Validation</h2>
          </div>
          <label class="flex items-start gap-3 cursor-pointer mb-8">
            <input type="checkbox" id="consent" name="consent" required class="w-5 h-5 mt-0.5 accent-[#d4a762] rounded" />
            <span class="text-sm text-gray-600">J'accepte d'être recontacté par JCBO Conseil. Mes données seront traitées conformément à notre <a href="/mentions-legales#donnees" class="text-gold hover:underline">politique de confidentialité</a>.</span>
          </label>
          <button type="submit" class="w-full bg-gold text-navy font-bold py-4 rounded-full text-lg hover:bg-gold-light hover:-translate-y-0.5 transition-all shadow-lg shadow-gold/20">
            Être recontacté
          </button>
        </div>

      </form>
    </div>
  </section>

  <!-- Infos contact -->
  <section class="py-16 bg-navy text-white">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="w-14 h-14 bg-white/5 border border-gold/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="font-heading font-bold text-white mb-1">Adresse</h3>
          <p class="text-white/50 text-sm">87 Rue Achille Viadieu<br>31400 Toulouse, France</p>
        </div>
        <div>
          <div class="w-14 h-14 bg-white/5 border border-gold/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3 class="font-heading font-bold text-white mb-1">Téléphone</h3>
          <p class="text-white/50 text-sm"><a href="tel:+33615630938" class="text-gold hover:text-gold-light">+33 6 15 63 09 38</a> (France)<br><span class="text-white/40">+237 6 95 88 65 59</span> (Cameroun)</p>
        </div>
        <div>
          <div class="w-14 h-14 bg-white/5 border border-gold/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3 class="font-heading font-bold text-white mb-1">Email</h3>
          <p class="text-white/50 text-sm"><a href="mailto:jcboyang@gmail.com" class="text-gold hover:text-gold-light">jcboyang@gmail.com</a></p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
