      "permanent": true
    },
    {
      "source": "/ACTUBia/",
      "destination": "/actualites",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/actualites",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/actualites",
      "permanent": true
    },
    {
      "source": "/Blog",
      "destination": "/actualites",
      "permanent": true
    },
    {
      "source": "/Blog/",
      "destination": "/actualites",
      "permanent": true
    },
    {
