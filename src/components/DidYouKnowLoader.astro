---
import { didYouKnowFacts, homePreloadImages } from '../data/did-you-know';

interface Props {
  images?: readonly string[];
  facts?: readonly string[];
}

const images = Astro.props.images ?? homePreloadImages;
const facts = Astro.props.facts ?? didYouKnowFacts;
const firstFact = facts[0] ?? '';
---

<div
  id="dyk-banner"
  class="fixed bottom-4 left-4 right-4 md:left-auto md:right-6 md:max-w-md z-[1001] bg-navy text-white rounded-xl shadow-[0_8px_32px_rgba(0,0,0,0.35)] border border-gold/25 overflow-hidden transition-all duration-400"
  role="status"
  aria-live="polite"
  aria-labelledby="dyk-title"
>
  <div class="flex items-start gap-3 p-4 pr-3">
    <div class="shrink-0 w-8 h-8 rounded-lg bg-gold/15 flex items-center justify-center mt-0.5" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2">
        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
      </svg>
    </div>

    <div class="flex-1 min-w-0">
      <p id="dyk-title" class="font-accent italic text-gold text-xs uppercase tracking-[0.15em] mb-1">
        Le saviez-vous ?
      </p>
      <p
        id="dyk-fact"
        class="text-sm leading-snug text-white/90 transition-opacity duration-300"
      >
        {firstFact}
      </p>
      <button
        type="button"
        id="dyk-dismiss"
        class="mt-2 text-[0.7rem] text-gold/70 hover:text-gold underline underline-offset-2 transition-colors"
      >
        Ne plus afficher
      </button>
    </div>

    <button
      type="button"
      id="dyk-close"
      class="shrink-0 w-7 h-7 flex items-center justify-center rounded-lg text-white/40 hover:text-white hover:bg-white/10 transition-colors text-lg leading-none"
      aria-label="Fermer"
    >
      &times;
    </button>
  </div>
</div>

<style>
  #dyk-banner.dyk-fade-out {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  #dyk-fact.dyk-fact-exit {
    opacity: 0;
  }

  #dyk-fact.dyk-fact-enter {
    animation: dykFactIn 0.35s ease forwards;
  }

  @keyframes dykFactIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script define:vars={{ images: [...images], facts: [...facts] }}>
  import { initDidYouKnowLoader } from '../scripts/did-you-know-loader';
  initDidYouKnowLoader(images, facts);
</script>
