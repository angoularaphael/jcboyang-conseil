---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const niveaux = [
  {
    num: '1',
    title: 'LES FONDAMENTAUX',
    subtitle: 'Vous apprenez à vendre',
    items: ['Développer votre mindset commercial', 'Comprendre vos clients', 'Structurer votre discours', 'Maîtriser les bases de la vente'],
    objectif: 'Devenir crédible et efficace',
    icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z',
  },
  {
    num: '2',
    title: 'PERFORMANCE COMMERCIALE',
    subtitle: 'Vous générez du chiffre d\'affaires',
    items: ['Vendre des offres à forte valeur', 'Attirer des clients qualifiés', 'Structurer votre prospection', 'Maîtriser la négociation'],
    objectif: 'Devenir performant et rentable',
    icon: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  },
  {
    num: '3',
    title: 'CERTIFICATION & BUSINESS',
    subtitle: 'Vous créez votre propre activité',
    items: ['Devenir consultant VENDEUR ATTITUDE\u2122', 'Vendre et animer des formations', 'Développer votre portefeuille client', 'Générer des revenus importants'],
    objectif: 'Devenir indépendant et scalable',
    icon: 'M22 12h-4l-3 9L9 3l-3 9H2',
  },
];

const cibles = [
  { label: 'Entrepreneurs', icon: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z' },
  { label: 'Consultants', icon: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z|M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z' },
  { label: 'Dirigeants', icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z' },
  { label: 'Business developers', icon: 'M22 12h-4l-3 9L9 3l-3 9H2' },
  { label: 'Commerciaux', icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2|M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z' },
  { label: 'Porteurs de projets', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
];
---
<Layout title="VENDEUR ATTITUDE™ by JCBO-CONSEIL | Programme de Transformation Commerciale" description="VENDEUR ATTITUDE™ : la méthode de transformation commerciale pour entrepreneurs, consultants et dirigeants. Apprenez à vous vendre, convaincre et performer.">
  <Header />
  <div class="pt-24"></div>

  <!-- Hero -->
  <section class="py-20 bg-navy text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 20% 50%, #d4a762 0%, transparent 50%), radial-gradient(circle at 80% 50%, #d4a762 0%, transparent 50%);"></div>
    <div class="max-w-[900px] mx-auto px-6 text-center relative">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.15em] mb-4">Présentation du programme</span>
      <h1 class="font-heading text-[clamp(2rem,5vw,3.5rem)] font-bold mb-3">VENDEUR ATTITUDE<span class="text-gold">&trade;</span></h1>
      <p class="font-accent italic text-gold text-lg mb-8">by JCBO-CONSEIL</p>
      <div class="w-20 h-0.5 bg-gold mx-auto mb-8"></div>
      <p class="text-white/80 text-xl md:text-2xl font-heading leading-relaxed mb-3">Vous ne manquez pas de compétences&hellip;</p>
      <p class="text-gold text-2xl md:text-3xl font-heading font-bold">Vous manquez de capacité à vous vendre.</p>
    </div>
  </section>

  <!-- Le constat -->
  <section class="py-16 bg-white">
    <div class="max-w-[800px] mx-auto px-6">
      <p class="text-gray-600 text-lg leading-relaxed mb-8">Aujourd'hui, la majorité des entrepreneurs, consultants, cadres et dirigeants font face à une réalité frustrante :</p>
      <div class="space-y-4 mb-10">
        <div class="flex items-start gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="mt-1 flex-shrink-0"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <p class="text-gray-600">Ils travaillent dur&hellip; <strong class="text-navy">mais les résultats ne suivent pas</strong></p>
        </div>
        <div class="flex items-start gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="mt-1 flex-shrink-0"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <p class="text-gray-600">Ils ont des offres&hellip; <strong class="text-navy">mais peinent à convaincre</strong></p>
        </div>
        <div class="flex items-start gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="mt-1 flex-shrink-0"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <p class="text-gray-600">Ils ont du potentiel&hellip; <strong class="text-navy">mais restent invisibles</strong></p>
        </div>
      </div>
      <div class="bg-navy/5 border-l-4 border-gold rounded-r-xl p-6 mb-8">
        <p class="text-gray-500 mb-2">Et pendant ce temps, d'autres — parfois moins compétents — réussissent. <strong class="text-navy">Pourquoi ?</strong></p>
      </div>
      <div class="bg-navy rounded-2xl p-8 text-center">
        <p class="text-white/70 text-lg mb-2">Parce que le marché ne récompense pas les meilleurs&hellip;</p>
        <p class="text-gold text-2xl font-heading font-bold">Il récompense ceux qui savent se vendre.</p>
      </div>
    </div>
  </section>

  <!-- Qu'est-ce que VENDEUR ATTITUDE -->
  <section class="py-20 bg-offwhite">
    <div class="max-w-[900px] mx-auto px-6">
      <div class="text-center mb-12">
        <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">La méthode</span>
        <h2 class="font-heading text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-navy mb-4">Qu'est-ce que <span class="text-gold">VENDEUR ATTITUDE&trade;</span> ?</h2>
        <div class="w-14 h-0.5 bg-gold mx-auto"></div>
      </div>
      <p class="text-gray-600 text-lg text-center mb-10">VENDEUR ATTITUDE&trade; by JCBO-CONSEIL est une méthode de transformation commerciale conçue pour vous apprendre à :</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        <div class="flex items-center gap-3 bg-white rounded-xl p-5 border border-gold/10">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span class="font-medium text-navy">Structurer votre discours</span>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-5 border border-gold/10">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span class="font-medium text-navy">Comprendre vos clients en profondeur</span>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-5 border border-gold/10">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span class="font-medium text-navy">Développer une posture crédible et impactante</span>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-5 border border-gold/10">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span class="font-medium text-navy">Convaincre sans forcer</span>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl p-5 border border-gold/10 md:col-span-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span class="font-medium text-navy">Et surtout&hellip; <strong class="text-gold">générer du chiffre d'affaires</strong></span>
        </div>
      </div>
      <div class="bg-white border-2 border-gold/20 rounded-2xl p-8 text-center">
        <p class="text-gray-500 mb-2">Ce n'est pas une simple formation à la vente.</p>
        <p class="text-navy text-xl font-heading font-bold">C'est un changement de posture, une montée en puissance, une transformation stratégique.</p>
      </div>
    </div>
  </section>

  <!-- Vérité -->
  <section class="py-14 bg-navy text-center">
    <div class="max-w-[700px] mx-auto px-6">
      <p class="text-white/70 text-lg mb-3">Vous pouvez avoir la meilleure offre du monde&hellip;</p>
      <p class="text-gold text-2xl md:text-3xl font-heading font-bold">Si vous ne savez pas la vendre, elle ne vaut rien.</p>
    </div>
  </section>

  <!-- Avant / Après -->
  <section class="py-20 bg-white">
    <div class="max-w-[900px] mx-auto px-6">
      <div class="text-center mb-12">
        <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">La transformation</span>
        <h2 class="font-heading text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-navy">Ce que VENDEUR ATTITUDE&trade; va <span class="text-gold">changer pour vous</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Avant -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200">
          <div class="flex items-center gap-2 mb-6">
            <div class="w-10 h-10 bg-red-100 rounded-xl flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </div>
            <h3 class="font-heading text-xl font-bold text-gray-400 uppercase tracking-wider">Avant</h3>
          </div>
          <ul class="space-y-4">
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-red-300 rounded-full flex-shrink-0"></span><span class="text-gray-500">Vous hésitez</span></li>
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-red-300 rounded-full flex-shrink-0"></span><span class="text-gray-500">Vous doutez</span></li>
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-red-300 rounded-full flex-shrink-0"></span><span class="text-gray-500">Vous expliquez trop</span></li>
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-red-300 rounded-full flex-shrink-0"></span><span class="text-gray-500">Vous perdez des opportunités</span></li>
          </ul>
        </div>
        <!-- Après -->
        <div class="bg-navy rounded-2xl p-8 border-2 border-gold/20">
          <div class="flex items-center gap-2 mb-6">
            <div class="w-10 h-10 bg-gold/10 rounded-xl flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3 class="font-heading text-xl font-bold text-gold uppercase tracking-wider">Après</h3>
          </div>
          <ul class="space-y-4">
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-gold rounded-full flex-shrink-0"></span><span class="text-white/80">Vous maîtrisez votre discours</span></li>
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-gold rounded-full flex-shrink-0"></span><span class="text-white/80">Vous inspirez confiance</span></li>
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-gold rounded-full flex-shrink-0"></span><span class="text-white/80">Vous savez convaincre</span></li>
            <li class="flex items-center gap-3"><span class="w-2 h-2 bg-gold rounded-full flex-shrink-0"></span><span class="text-white/80">Vous signez des clients</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Niveaux -->
  <section class="py-20 bg-offwhite">
    <div class="max-w-[1100px] mx-auto px-6">
      <div class="text-center mb-14">
        <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Progression structurée</span>
        <h2 class="font-heading text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-navy mb-3">Un programme structuré en <span class="text-gold">3 niveaux</span></h2>
        <p class="text-gray-500 max-w-xl mx-auto">Pour garantir une transformation réelle et progressive, le programme VENDEUR ATTITUDE&trade; est structuré en trois niveaux complémentaires.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {niveaux.map(n => (
          <div class="bg-white rounded-2xl p-8 border border-gold/10 hover:-translate-y-1 hover:shadow-xl transition-all relative">
            <div class="absolute -top-4 left-8">
              <span class="bg-gold text-navy text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider">Niveau {n.num}</span>
            </div>
            <div class="w-14 h-14 bg-navy rounded-2xl flex items-center justify-center mb-5 mt-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2">{n.icon.split('|').map(d => <path d={d} />)}</svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-navy mb-1">{n.title}</h3>
            <p class="font-accent italic text-gold text-sm mb-5">{n.subtitle}</p>
            <ul class="space-y-3 mb-6">
              {n.items.map(item => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5" class="mt-0.5 flex-shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {item}
                </li>
              ))}
            </ul>
            <div class="bg-navy/5 rounded-xl px-4 py-3">
              <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5">Objectif</p>
              <p class="font-heading font-bold text-navy text-sm">{n.objectif}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- À qui s'adresse ce programme -->
  <section class="py-20 bg-navy text-white">
    <div class="max-w-[1100px] mx-auto px-6">
      <div class="text-center mb-14">
        <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Pour qui ?</span>
        <h2 class="font-heading text-[clamp(1.8rem,4vw,2.6rem)] font-bold text-white mb-3">À qui s'adresse <span class="text-gold">ce programme</span> ?</h2>
        <p class="text-white/50">Toute personne qui veut mieux vendre et gagner plus.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-14">
        {cibles.map(c => (
          <div class="bg-white/5 border border-gold/10 rounded-2xl p-6 text-center hover:border-gold/30 transition-all">
            <div class="w-12 h-12 bg-gold/10 rounded-xl flex items-center justify-center mx-auto mb-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2">{c.icon.split('|').map(d => <path d={d} />)}</svg>
            </div>
            <p class="font-heading font-bold text-white text-sm">{c.label}</p>
          </div>
        ))}
      </div>

      <!-- Pas pour vous si -->
      <div class="max-w-[700px] mx-auto bg-white/5 border border-red-500/20 rounded-2xl p-8">
        <h3 class="font-heading text-lg font-bold text-white mb-5 flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          Ce programme n'est pas pour vous si :
        </h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-white/60">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="flex-shrink-0"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Vous cherchez des solutions rapides sans effort
          </li>
          <li class="flex items-center gap-3 text-white/60">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="flex-shrink-0"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Vous refusez de vous remettre en question
          </li>
          <li class="flex items-center gap-3 text-white/60">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="flex-shrink-0"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Vous n'êtes pas prêt à passer à l'action
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Vérité finale -->
  <section class="py-14 bg-white">
    <div class="max-w-[700px] mx-auto px-6 text-center">
      <p class="text-gray-500 text-lg mb-3">Vous pouvez continuer à espérer que les clients viennent à vous&hellip;</p>
      <p class="text-navy text-2xl font-heading font-bold">Ou décider d'apprendre à vendre et <span class="text-gold">changer de niveau.</span></p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-navy text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 50% 50%, #d4a762 0%, transparent 60%);"></div>
    <div class="max-w-[700px] mx-auto px-6 relative">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.15em] mb-4">Passez à l'action</span>
      <h2 class="font-heading text-[clamp(1.6rem,3.5vw,2.4rem)] font-bold text-white mb-3">Rejoignez le programme <span class="text-gold">VENDEUR ATTITUDE&trade;</span></h2>
      <p class="text-white/50 mb-10">Et développez enfin votre capacité à convaincre, vendre et performer.</p>
      <div class="flex items-center justify-center gap-4 flex-wrap">
        <a href="/reserver" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-4 px-10 rounded-full text-lg hover:bg-gold-light hover:-translate-y-0.5 transition-all shadow-lg shadow-gold/20">Rejoindre le programme</a>
        <a href="/contact" class="inline-flex items-center gap-2 border border-white/30 text-white font-bold py-4 px-10 rounded-full text-lg hover:border-gold hover:text-gold transition-all">Nous contacter</a>
      </div>
      <div class="mt-10 pt-8 border-t border-white/10">
        <p class="font-heading text-white font-bold mb-1">JCBO-CONSEIL</p>
        <p class="font-accent italic text-gold text-sm mb-3">Accélérez votre croissance, révélez votre potentiel.</p>
        <p class="text-white/40 text-sm">jcbo.conseil@gmail.com &middot; <a href="https://jcbo-conseil.com" class="text-gold hover:underline">jcbo-conseil.com</a></p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
