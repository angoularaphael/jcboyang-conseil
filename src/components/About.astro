---
const credentials = [
  'Consultant certifié',
  'Formateur en ESC',
  'Coach professionnel',
  'Partenaire AKOMCA',
  'Interventions internationales',
];
---
<section class="py-20 md:py-28 bg-white" id="about">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.3fr] gap-12 lg:gap-16 items-center">
      <!-- Image -->
      <div class="relative" data-animate="fade-right">
        <div class="relative rounded-2xl overflow-hidden aspect-[3/4] max-w-[350px] mx-auto lg:mx-0">
          <img src="/images/2022/IMG-20240503-WA0065.jpg" alt="Jean-Christophe Boyang-Tsang" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="absolute -bottom-4 -right-4 lg:right-auto lg:-bottom-5 lg:-left-5 bg-navy text-white py-4 px-6 rounded-xl shadow-xl text-center">
          <span class="block font-heading text-3xl font-bold text-gold leading-none">30+</span>
          <span class="text-[0.7rem] uppercase tracking-widest text-white/60">ans sur le terrain</span>
        </div>
      </div>
      <!-- Content -->
      <div data-animate="fade-left">
        <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Qui vous accompagne</span>
        <h2 class="font-heading text-[clamp(1.6rem,3.5vw,2.2rem)] font-bold text-navy mb-1">Jean-Christophe Boyang-Tsang</h2>
        <p class="text-gold font-accent italic text-lg mb-6">Consultant Expert en Business Development</p>
        <p class="text-gray-500 mb-4 leading-relaxed">
          Pas un théoricien. <strong class="text-gray-700">Un homme de terrain.</strong> 30 ans à diriger des équipes commerciales, à former des forces de vente et à structurer la croissance de PME en France et à l'international.
        </p>
        <p class="text-gray-500 mb-6 leading-relaxed">
          Formateur en écoles supérieures de commerce, consultant certifié et coach professionnel. J'ai vu ce qui fonctionne — et surtout ce qui ne fonctionne pas — dans des centaines d'entreprises.
        </p>
        <div class="flex flex-wrap gap-3 mb-8">
          {credentials.map(c => (
            <div class="flex items-center gap-2 bg-offwhite border border-gold/10 rounded-lg px-4 py-2 text-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span class="text-navy font-medium">{c}</span>
            </div>
          ))}
        </div>
        <a href="/contact" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3.5 px-8 rounded-full hover:bg-gold-light transition-all">Discuter de votre situation</a>
      </div>
    </div>
  </div>
</section>
