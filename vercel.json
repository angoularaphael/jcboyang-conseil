{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.notchpay.co https://www.adhesion-jcbo-conseil.com https://adhesion-jcbo-conseil.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jcbo-conseil.com" }],
      "destination": "https://www.jcbo-conseil.com/:path*",
      "permanent": true
    },
    {
      "source": "/formations",
      "destination": "/prestations#formations",
      "permanent": true
    },
    {
      "source": "/formations/",
      "destination": "/prestations#formations",
      "permanent": true
    },
    {
      "source": "/Formations",
      "destination": "/prestations#formations",
      "permanent": true
    },
    {
      "source": "/Formations/",
      "destination": "/prestations#formations",
      "permanent": true
    },
    {
      "source": "/coaching",
      "destination": "/prestations#coaching",
      "permanent": true
    },
    {
      "source": "/coaching/",
      "destination": "/prestations#coaching",
      "permanent": true
    },
    {
      "source": "/Coaching",
      "destination": "/prestations#coaching",
      "permanent": true
    },
    {
      "source": "/Coaching/",
      "destination": "/prestations#coaching",
      "permanent": true
    },
    {
      "source": "/jcbo",
      "destination": "/a-propos",
      "permanent": true
    },
    {
      "source": "/jcbo/",
      "destination": "/a-propos",
      "permanent": true
    },
    {
      "source": "/JCBO",
      "destination": "/a-propos",
      "permanent": true
    },
    {
      "source": "/JCBO/",
      "destination": "/a-propos",
      "permanent": true
    },
    {
      "source": "/temoignages",
      "destination": "/resultats",
      "permanent": true
    },
    {
      "source": "/temoignages/",
      "destination": "/resultats",
      "permanent": true
    },
    {
      "source": "/Temoignages",
      "destination": "/resultats",
      "permanent": true
    },
    {
      "source": "/Temoignages/",
      "destination": "/resultats",
      "permanent": true
    },
    {
      "source": "/actubia",
      "destination": "/actualites",
      "permanent": true
    },
    {
      "source": "/actubia/",
      "destination": "/actualites",
      "permanent": true
    },
    {
      "source": "/actu-bia",
      "destination": "/actualites",
      "permanent": true
    },
    {
      "source": "/actu-bia/",
      "destination": "/actualites",
