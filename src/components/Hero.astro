---
import { heroMedia } from '../data/hero-media';

const videoSrc = import.meta.env.PUBLIC_HERO_VIDEO_URL ?? heroMedia.home.video;
const videoPoster = heroMedia.home.poster;
---
<section class="relative min-h-screen flex items-center justify-center text-center text-white overflow-hidden" id="hero">
  <!-- Vidéo de fond -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <video
      class="absolute inset-0 w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={videoPoster}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-navy/75"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_50%,rgba(212,167,98,0.1)_0%,transparent_60%),radial-gradient(ellipse_at_80%_20%,rgba(212,167,98,0.06)_0%,transparent_50%)]"></div>
  </div>

  <div class="relative z-10 max-w-[1200px] mx-auto px-6 pt-28 pb-20">
    <!-- Trust bar -->
    <div class="flex items-center justify-center gap-3 flex-wrap text-xs text-white/50 mb-8" data-animate="fade-down">
      <span class="flex items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#d4a762"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
        <span class="text-gold">4.9/5</span> — 47 avis
      </span>
      <span class="text-white/20">|</span>
      <span>30+ ans d'expertise terrain</span>
      <span class="text-white/20">|</span>
      <span>500+ professionnels accompagnés</span>
    </div>

    <!-- Title -->
    <h1 class="font-heading font-bold leading-tight mb-6" data-animate="fade-up">
      <span class="block text-lg md:text-xl font-accent italic text-gold/80 mb-3">Votre entreprise stagne ?</span>
      <span class="block text-[clamp(2.2rem,5.5vw,4rem)]">Transformez votre stratégie<br class="hidden md:block"> en <span class="text-gold">machine à clients</span></span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base md:text-lg text-white/65 max-w-2xl mx-auto mb-8 leading-relaxed" data-animate="fade-up" data-delay="200">
      <strong class="text-gold-light">Accélérez votre croissance. Révélez votre potentiel.</strong><br>
      JCBO Conseil structure votre approche commerciale pour générer des leads qualifiés, convertir plus et scaler votre activité.
    </p>

    <!-- CTA -->
    <div class="flex items-center justify-center gap-4 flex-wrap mb-3" data-animate="fade-up" data-delay="400">
      <a href="/contact" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-4 px-8 rounded-full text-[0.95rem] hover:bg-gold-light hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(212,167,98,0.3)] transition-all">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg>
        Être recontacté
      </a>
      <a href="/offres" class="inline-flex items-center gap-2 border border-white/30 text-white font-semibold py-4 px-8 rounded-full text-[0.95rem] hover:border-gold hover:text-gold hover:-translate-y-0.5 transition-all">Nos offres</a>
    </div>
    <p class="text-xs text-white/35 mb-14" data-animate="fade-up" data-delay="500">Appel stratégique de 30 min · Gratuit · Sans engagement</p>

    <!-- Stats -->
    <div class="flex items-center justify-center gap-8 md:gap-12 flex-wrap" data-animate="fade-up" data-delay="600">
      <div class="text-center">
        <span class="block font-heading text-4xl font-bold text-gold leading-none"><span data-count="35">0</span><span class="text-2xl">%</span></span>
        <span class="block text-[0.7rem] text-white/40 uppercase tracking-widest mt-1">CA moyen en +</span>
      </div>
      <div class="w-px h-10 bg-gold/20"></div>
      <div class="text-center">
        <span class="block font-heading text-4xl font-bold text-gold leading-none"><span data-count="98">0</span><span class="text-2xl">%</span></span>
        <span class="block text-[0.7rem] text-white/40 uppercase tracking-widest mt-1">Clients satisfaits</span>
      </div>
      <div class="w-px h-10 bg-gold/20"></div>
      <div class="text-center">
        <span class="block font-heading text-4xl font-bold text-gold leading-none"><span data-count="500">0</span><span class="text-2xl">+</span></span>
        <span class="block text-[0.7rem] text-white/40 uppercase tracking-widest mt-1">Pros accompagnés</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="#probleme" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10" aria-label="Défiler">
    <div class="w-6 h-[38px] border border-gold/40 rounded-xl flex justify-center pt-2">
      <div class="w-[3px] h-2 bg-gold rounded animate-scroll-down"></div>
    </div>
  </a>
</section>
