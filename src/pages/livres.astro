---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { heroMedia } from '../data/hero-media';
import { marked } from 'marked';

import { apiUrl as API_URL } from '../data/site-config';

marked.setOptions({ breaks: true });

type PublicLivre = {
  id: string;
  titre: string;
  auteur: string;
  description: string;
  descHtml: string;
  couverture_url: string;
  amazon_url: string;
  statut: string;
  ordre: number;
  slug: string | null;
};

let livres: PublicLivre[] = [];

try {
  const res = await fetch(`${API_URL}/api/public/livres`, { headers: { Accept: 'application/json' } });
  if (res.ok) {
    const data = (await res.json()) as {
      livres?: {
        id: string;
        titre: string;
        auteur: string;
        description: string;
        couverture_url: string;
        amazon_url: string;
        statut: string;
        ordre: number;
        slug: string | null;
      }[];
    };
    livres = await Promise.all((data.livres ?? []).map(async (l) => ({
      ...l,
      descHtml: l.description ? String(await marked.parse(l.description)) : '',
    })));
  }
} catch {
  /* liste vide si API indisponible */
}
---
<Layout
  title="Livres — Jean-Christophe Boyang-Tsang | JCBO-CONSEIL®"
  description="Découvrez les livres de Jean-Christophe Boyang-Tsang, Fondateur de JCBO-CONSEIL®. Auteur du Guide du Pouvoir Transformationnel Personnel — disponible sur Amazon."
>
  <Header />
  <div class="pt-24"></div>

  <PageHero imageSrc={heroMedia.livres.image} imageAlt={heroMedia.livres.alt}>
    <div class="max-w-[800px] mx-auto px-6">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-3">Publications</span>
      <h1 class="font-heading text-[clamp(1.8rem,4vw,2.8rem)] font-bold mb-4">Mes <span class="text-gold">Livres</span></h1>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
      <p class="text-white/60">Les ouvrages de Jean-Christophe Boyang-Tsang, Fondateur de JCBO-CONSEIL® — disponibles sur Amazon.</p>
    </div>
  </PageHero>

  <section class="py-16 bg-white">
    <div class="max-w-[1100px] mx-auto px-6">
      {livres.length === 0 ? (
        <div class="text-center py-20 bg-offwhite rounded-2xl border border-gold/10">
          <svg class="mx-auto mb-4" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
          <p class="text-navy font-semibold mb-2">Aucun livre disponible pour le moment</p>
          <p class="text-gray-500 text-sm">Revenez bientôt pour découvrir nos publications.</p>
        </div>
      ) : (
        <div class="space-y-16">
          {livres.map((livre, i) => (
            <article class:list={["grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-10 lg:gap-16 items-start", i % 2 === 1 && "lg:grid-cols-[1fr_280px]"]} data-animate="fade-up">
              <!-- Couverture -->
              <div class:list={["flex justify-center", i % 2 === 1 && "lg:order-2"]}>
                {livre.couverture_url ? (
                  <a href={livre.amazon_url} target="_blank" rel="noopener noreferrer" class="group block" title={`Acheter "${livre.titre}" sur Amazon`}>
                    <div class="relative">
                      <img
                        src={livre.couverture_url}
                        alt={`Couverture — ${livre.titre}`}
                        class="w-full max-w-[240px] mx-auto rounded-xl shadow-2xl group-hover:shadow-gold/20 group-hover:-translate-y-1 transition-all duration-300 border border-gold/10"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 rounded-xl bg-navy/0 group-hover:bg-navy/5 transition-colors"></div>
                    </div>
                    <p class="text-center text-xs text-gray-400 mt-3 group-hover:text-gold transition-colors">Cliquer pour voir sur Amazon</p>
                  </a>
                ) : (
                  <div class="w-[200px] h-[280px] rounded-xl shadow-xl border border-gold/15 flex flex-col items-center justify-center gap-4 bg-offwhite">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d4a762" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
                    <span class="text-xs text-gray-400 text-center px-4">Couverture à venir</span>
                  </div>
                )}
              </div>

              <!-- Contenu -->
              <div class:list={[i % 2 === 1 && "lg:order-1"]}>
                <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-3">Par {livre.auteur}</span>
                <h2 class="font-heading text-[clamp(1.4rem,3vw,2rem)] font-bold text-navy mb-6 leading-tight">{livre.titre}</h2>

                {livre.descHtml && (
                  <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed mb-8 [&_strong]:text-navy [&_a]:text-gold [&_a]:underline [&_ul]:space-y-2" set:html={livre.descHtml}></div>
                )}

                <div class="flex flex-wrap gap-3">
                  <a
                    href={livre.amazon_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3.5 px-8 rounded-full hover:bg-gold-light hover:-translate-y-0.5 transition-all"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/></svg>
                    Acheter sur Amazon
                  </a>
                  <a
                    href={livre.amazon_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 border border-navy/20 text-navy font-semibold py-3.5 px-8 rounded-full hover:border-gold hover:text-gold transition-all text-sm"
                  >
                    Voir sur Amazon →
                  </a>
                </div>

                <p class="text-xs text-gray-400 mt-4 flex items-center gap-1.5">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/></svg>
                  Disponible sur Amazon — livraison rapide
                </p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-navy text-center">
    <div class="max-w-[700px] mx-auto px-6">
      <h2 class="font-heading text-2xl font-bold text-white mb-4">Prêt à transformer votre <span class="text-gold">potentiel</span> ?</h2>
      <p class="text-white/50 mb-8">Après la lecture, passez à l'action avec un accompagnement personnalisé.</p>
      <div class="flex items-center justify-center gap-4 flex-wrap">
        <a href="/reserver" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3.5 px-8 rounded-full hover:bg-gold-light transition-all">Réserver une séance</a>
        <a href="/a-propos" class="inline-flex items-center gap-2 border border-white/30 text-white font-bold py-3.5 px-8 rounded-full hover:border-gold hover:text-gold transition-all">Découvrir JCBO-CONSEIL®</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
