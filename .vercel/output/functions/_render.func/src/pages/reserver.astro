---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const sessions = [
  { id: 'diagnostic', title: 'Diagnostic Stratégique', duration: '2h', priceEur: 490, priceCfa: '320 000' },
  { id: 'coaching', title: 'Coaching Stratégique', duration: '1h30', priceEur: 250, priceCfa: '150 000' },
  { id: 'pack3', title: 'Pack 3 séances Coaching', duration: '3 x 1h30', priceEur: 650, priceCfa: '420 000' },
  { id: 'premium', title: 'Accompagnement Premium 3 mois', duration: '6 séances', priceEur: 2400, priceCfa: '1 500 000' },
];
---
<Layout title="Réserver une Séance — JCBO Conseil | Paiement en Ligne" description="Réservez et payez votre séance de coaching stratégique en ligne. Parcours simple, rapide et sécurisé.">
  <Header />
  <div class="pt-24"></div>

  <!-- Hero -->
  <section class="py-14 bg-navy text-white text-center">
    <div class="max-w-[700px] mx-auto px-6">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-3">Réservation en ligne</span>
      <h1 class="font-heading text-[clamp(1.8rem,4vw,2.8rem)] font-bold mb-4">Réservez votre <span class="text-gold">séance</span></h1>
      <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
      <p class="text-white/60">3 étapes simples : choisissez, remplissez, payez. Sécurisé et instantané.</p>
    </div>
  </section>

  <!-- Booking -->
  <section class="py-16 bg-offwhite">
    <div class="max-w-[800px] mx-auto px-6">

      <!-- Step indicators -->
      <div class="flex items-center justify-center gap-4 mb-12">
        <div class="flex items-center gap-2" id="step-ind-1">
          <span class="w-8 h-8 bg-gold text-navy font-bold text-sm rounded-full flex items-center justify-center">1</span>
          <span class="text-sm font-semibold text-navy hidden sm:inline">Choisir</span>
        </div>
        <div class="w-12 h-px bg-gray-300"></div>
        <div class="flex items-center gap-2" id="step-ind-2">
          <span class="w-8 h-8 bg-gray-200 text-gray-500 font-bold text-sm rounded-full flex items-center justify-center">2</span>
          <span class="text-sm font-medium text-gray-400 hidden sm:inline">Informations</span>
        </div>
        <div class="w-12 h-px bg-gray-300"></div>
        <div class="flex items-center gap-2" id="step-ind-3">
          <span class="w-8 h-8 bg-gray-200 text-gray-500 font-bold text-sm rounded-full flex items-center justify-center">3</span>
          <span class="text-sm font-medium text-gray-400 hidden sm:inline">Paiement</span>
        </div>
      </div>

      <!-- Step 1: Choose session -->
      <div id="step1" class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm">
        <h2 class="font-heading text-xl font-bold text-navy mb-6">Choisissez votre prestation</h2>
        <div class="space-y-4">
          {sessions.map(s => (
            <label class="session-option flex items-center justify-between bg-offwhite rounded-xl px-5 py-4 cursor-pointer border-2 border-transparent hover:border-gold/30 transition-all" data-session-id={s.id}>
              <div class="flex items-center gap-4">
                <input type="radio" name="session" value={s.id} class="w-5 h-5 accent-[#d4a762]" />
                <div>
                  <p class="font-semibold text-navy">{s.title}</p>
                  <p class="text-gray-400 text-sm">{s.duration}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="font-heading font-bold text-navy">{s.priceEur} &euro;</p>
                <p class="text-gray-400 text-xs">{s.priceCfa} FCFA</p>
              </div>
            </label>
          ))}
        </div>

        <!-- Zone selection -->
        <div class="mt-6 p-4 bg-navy/5 rounded-xl">
          <p class="text-sm font-semibold text-navy mb-3">Votre zone de paiement :</p>
          <div class="flex gap-4">
            <label class="flex-1 flex items-center gap-2 bg-white rounded-lg px-4 py-3 cursor-pointer border-2 border-transparent hover:border-gold/30 transition-all">
              <input type="radio" name="zone" value="euro" checked class="w-4 h-4 accent-[#d4a762]" />
              <span class="text-sm font-medium">Zone Euro (&euro;)</span>
            </label>
            <label class="flex-1 flex items-center gap-2 bg-white rounded-lg px-4 py-3 cursor-pointer border-2 border-transparent hover:border-gold/30 transition-all">
              <input type="radio" name="zone" value="afrique" class="w-4 h-4 accent-[#d4a762]" />
              <span class="text-sm font-medium">Zone Afrique (FCFA)</span>
            </label>
          </div>
        </div>

        <button id="toStep2" class="w-full mt-6 bg-gold text-navy font-bold py-3.5 rounded-full hover:bg-gold-light transition-all opacity-50 cursor-not-allowed" disabled>Continuer</button>
      </div>

      <!-- Step 2: Info -->
      <div id="step2" class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm hidden">
        <h2 class="font-heading text-xl font-bold text-navy mb-6">Vos informations</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-navy mb-1.5">Nom & Prénom <span class="text-red-500">*</span></label>
            <input type="text" id="bk-name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-navy mb-1.5">Email <span class="text-red-500">*</span></label>
            <input type="email" id="bk-email" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-navy mb-1.5">Téléphone <span class="text-red-500">*</span></label>
            <input type="tel" id="bk-phone" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-navy mb-1.5">Entreprise</label>
            <input type="text" id="bk-company" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" />
          </div>
        </div>
        <div class="mt-5">
          <label class="block text-sm font-semibold text-navy mb-1.5">Date souhaitée</label>
          <input type="date" id="bk-date" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm" />
        </div>
        <div class="mt-5">
          <label class="block text-sm font-semibold text-navy mb-1.5">Message (optionnel)</label>
          <textarea id="bk-message" rows="3" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gold focus:ring-1 focus:ring-gold/30 outline-none transition-all text-sm resize-y"></textarea>
        </div>
        <div class="flex gap-4 mt-6">
          <button id="backStep1" class="flex-1 border-2 border-gray-200 text-gray-500 font-bold py-3.5 rounded-full hover:border-gold hover:text-gold transition-all">Retour</button>
          <button id="toStep3" class="flex-1 bg-gold text-navy font-bold py-3.5 rounded-full hover:bg-gold-light transition-all">Continuer</button>
        </div>
      </div>

      <!-- Step 3: Payment summary -->
      <div id="step3" class="bg-white rounded-2xl p-8 border border-gold/10 shadow-sm hidden">
        <h2 class="font-heading text-xl font-bold text-navy mb-6">Récapitulatif & Paiement</h2>
        <div class="bg-offwhite rounded-xl p-6 mb-6">
          <div class="flex justify-between items-center mb-3">
            <span class="font-semibold text-navy" id="summary-session">—</span>
            <span class="font-heading text-xl font-bold text-gold" id="summary-price">—</span>
          </div>
          <div class="text-sm text-gray-400 space-y-1">
            <p>Nom : <span class="text-gray-600" id="summary-name">—</span></p>
            <p>Email : <span class="text-gray-600" id="summary-email">—</span></p>
            <p>Date : <span class="text-gray-600" id="summary-date">—</span></p>
          </div>
        </div>

        <!-- Payment method selection -->
        <div class="space-y-3 mb-6">
          <p class="text-sm font-semibold text-navy">Mode de paiement :</p>
          <label class="flex items-center gap-3 bg-offwhite rounded-xl px-5 py-4 cursor-pointer border-2 border-transparent hover:border-gold/30 transition-all">
            <input type="radio" name="payment" value="card" checked class="w-4 h-4 accent-[#d4a762]" />
            <div class="flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0b1f3a" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              <span class="text-sm font-medium">Carte bancaire (Stripe)</span>
            </div>
          </label>
          <label class="flex items-center gap-3 bg-offwhite rounded-xl px-5 py-4 cursor-pointer border-2 border-transparent hover:border-gold/30 transition-all">
            <input type="radio" name="payment" value="transfer" class="w-4 h-4 accent-[#d4a762]" />
            <div class="flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0b1f3a" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span class="text-sm font-medium">Virement bancaire</span>
            </div>
          </label>
          <label class="flex items-center gap-3 bg-offwhite rounded-xl px-5 py-4 cursor-pointer border-2 border-transparent hover:border-gold/30 transition-all">
            <input type="radio" name="payment" value="mobile" class="w-4 h-4 accent-[#d4a762]" />
            <div class="flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0b1f3a" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              <span class="text-sm font-medium">Mobile Money (Zone Afrique)</span>
            </div>
          </label>
        </div>

        <div class="flex items-start gap-3 mb-6">
          <input type="checkbox" id="bk-consent" class="w-5 h-5 mt-0.5 accent-[#d4a762]" />
          <label for="bk-consent" class="text-sm text-gray-500">J'accepte les <a href="/mentions-legales" class="text-gold hover:underline">conditions générales</a> et confirme ma réservation.</label>
        </div>

        <div class="flex gap-4">
          <button id="backStep2" class="flex-1 border-2 border-gray-200 text-gray-500 font-bold py-3.5 rounded-full hover:border-gold hover:text-gold transition-all">Retour</button>
          <button id="payBtn" class="flex-1 bg-gold text-navy font-bold py-4 rounded-full hover:bg-gold-light transition-all shadow-lg shadow-gold/20 text-lg">Payer <span id="pay-amount"></span></button>
        </div>

        <!-- Sécurité -->
        <div class="flex items-center justify-center gap-4 mt-6 text-xs text-gray-400">
          <span class="flex items-center gap-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Paiement sécurisé</span>
          <span>·</span>
          <span>Données chiffrées SSL</span>
          <span>·</span>
          <span>Confirmation par email</span>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const step1 = document.getElementById('step1');
  const step2 = document.getElementById('step2');
  const step3 = document.getElementById('step3');
  const toStep2Btn = document.getElementById('toStep2');
  const toStep3Btn = document.getElementById('toStep3');
  const backStep1Btn = document.getElementById('backStep1');
  const backStep2Btn = document.getElementById('backStep2');
  const payBtn = document.getElementById('payBtn');

  // Enable continue when session selected
  document.querySelectorAll('input[name="session"]').forEach(r => {
    r.addEventListener('change', () => {
      toStep2Btn.disabled = false;
      toStep2Btn.classList.remove('opacity-50', 'cursor-not-allowed');
      // Highlight selected
      document.querySelectorAll('.session-option').forEach(o => o.classList.remove('border-gold'));
      r.closest('.session-option').classList.add('border-gold');
    });
  });

  function showStep(n) {
    [step1, step2, step3].forEach(s => s.classList.add('hidden'));
    [step1, step2, step3][n - 1].classList.remove('hidden');
    // Update indicators
    for (let i = 1; i <= 3; i++) {
      const ind = document.getElementById('step-ind-' + i);
      const circle = ind.querySelector('span:first-child');
      if (i <= n) { circle.className = 'w-8 h-8 bg-gold text-navy font-bold text-sm rounded-full flex items-center justify-center'; }
      else { circle.className = 'w-8 h-8 bg-gray-200 text-gray-500 font-bold text-sm rounded-full flex items-center justify-center'; }
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  toStep2Btn.addEventListener('click', () => showStep(2));
  backStep1Btn.addEventListener('click', () => showStep(1));

  toStep3Btn.addEventListener('click', () => {
    const name = document.getElementById('bk-name').value;
    const email = document.getElementById('bk-email').value;
    const phone = document.getElementById('bk-phone').value;
    if (!name || !email || !phone) { alert('Veuillez remplir les champs obligatoires.'); return; }

    // Fill summary
    const sessions = { diagnostic: 'Diagnostic Stratégique', coaching: 'Coaching Stratégique', pack3: 'Pack 3 séances', premium: 'Accompagnement Premium' };
    const pricesEur = { diagnostic: 490, coaching: 250, pack3: 650, premium: 2400 };
    const sel = document.querySelector('input[name="session"]:checked').value;
    const zone = document.querySelector('input[name="zone"]:checked').value;

    document.getElementById('summary-session').textContent = sessions[sel] || sel;
    document.getElementById('summary-price').textContent = zone === 'euro' ? pricesEur[sel] + ' €' : '—  FCFA';
    document.getElementById('summary-name').textContent = name;
    document.getElementById('summary-email').textContent = email;
    document.getElementById('summary-date').textContent = document.getElementById('bk-date').value || 'À convenir';
    document.getElementById('pay-amount').textContent = zone === 'euro' ? pricesEur[sel] + ' €' : '';
    showStep(3);
  });

  backStep2Btn.addEventListener('click', () => showStep(2));

  payBtn.addEventListener('click', () => {
    const consent = document.getElementById('bk-consent').checked;
    if (!consent) { alert('Veuillez accepter les conditions.'); return; }
    // TODO: Integrate Stripe Checkout or other payment gateway
    alert('Redirection vers le paiement sécurisé... (Intégration Stripe à connecter)');
  });
});
</script>
