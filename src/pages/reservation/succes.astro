---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const sessionId = Astro.url.searchParams.get('session_id') ?? '';
const provider = Astro.url.searchParams.get('provider') ?? '';
const notchReference =
  Astro.url.searchParams.get('reference') ??
  Astro.url.searchParams.get('trxref') ??
  '';
const paymentRef = provider === 'notchpay' ? notchReference : sessionId;
const factureParam = provider === 'notchpay' ? 'reference' : 'session_id';
const factureId = provider === 'notchpay' ? notchReference : sessionId;
const factureHref =
  factureId && provider
    ? `/api/reservation/facture?provider=${encodeURIComponent(provider)}&${factureParam}=${encodeURIComponent(factureId)}`
    : factureId
      ? `/api/reservation/facture?provider=stripe&session_id=${encodeURIComponent(factureId)}`
      : '';
---
<Layout title="Paiement confirmé — JCBO Conseil" description="Votre réservation est confirmée. Notre équipe vous recontactera très rapidement." noindex>
  <Header />
  <div class="pt-24"></div>

  <section class="py-20 bg-offwhite">
    <div class="max-w-[720px] mx-auto px-6">
      <div class="bg-white rounded-2xl p-10 text-center border border-gold/10 shadow-sm">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center bg-green-50">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Merci</span>
        <h1 class="font-heading text-3xl font-bold text-navy mb-3">Paiement <span class="text-gold">confirmé</span></h1>
        <div class="w-14 h-0.5 bg-gold mx-auto mb-5"></div>
        <p class="text-gray-500 mb-4 leading-relaxed">
          Votre réservation a bien été enregistrée. Votre <strong class="text-navy">facture</strong> vous sera envoyée par e-mail dans quelques instants (vérifiez aussi les spams).
          L'équipe JCBO Conseil vous recontactera très rapidement pour planifier votre séance.
        </p>
        <p id="invoice-status" class="text-sm text-gold-dark mb-4 hidden" role="status"></p>
        {factureHref && (
          <a
            id="facture-link"
            href={factureHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-gold text-navy font-bold py-3 px-8 rounded-full hover:bg-gold/10 transition-all mb-4"
          >
            Voir ma facture
          </a>
        )}
        {paymentRef && (
          <p class="text-xs text-gray-400 mb-8">Référence paiement : <code class="font-mono">{paymentRef}</code></p>
        )}
        <a href="/" class="inline-flex items-center gap-2 bg-gold text-navy font-bold py-3 px-8 rounded-full hover:bg-gold-light transition-all">
          Retour à l'accueil
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

{(sessionId || (provider === 'notchpay' && notchReference)) && (
  <script define:vars={{ sessionId, provider, notchReference }}>
    (async () => {
      const statusEl = document.getElementById("invoice-status");
      try {
        const url =
          provider === "notchpay" && notchReference
            ? `/api/notchpay/fulfill?reference=${encodeURIComponent(notchReference)}`
            : `/api/stripe/fulfill?session_id=${encodeURIComponent(sessionId)}`;
        const res = await fetch(url, { method: "POST" });
        const data = await res.json();
        if (statusEl && data.ok && data.emailSent) {
          statusEl.textContent = "Votre facture a été envoyée à votre adresse e-mail.";
          statusEl.classList.remove("hidden");
        }
        if (data.factureUrl) {
          const factureLink = document.getElementById("facture-link");
          if (factureLink instanceof HTMLAnchorElement) {
            factureLink.href = data.factureUrl;
          }
        }
      } catch {
        /* le webhook peut aussi déclencher l'envoi */
      }
    })();
  </script>
)}
