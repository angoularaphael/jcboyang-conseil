---
const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/a-propos', label: 'JCBO' },
  { href: '/methode', label: 'Méthode' },
  { href: '/prestations', label: 'Prestations' },
  { href: '/seminaires', label: 'Séminaires' },
  { href: '/actualites', label: 'Actualités' },
  { href: '/livres', label: 'Livres' },
  { href: '/ressources', label: 'Ressources' },
];
const mobileExtra = [
  { href: '/a-propos#transformation-organisationnelle', label: 'Transformation org.' },
  { href: '/a-propos#business-development', label: 'Business Development' },
  { href: '/resultats', label: 'Résultats' },
  { href: '/faq', label: 'FAQ' },
];
const rawPath = Astro.url.pathname;
const currentPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');
const isActive = (href: string) => currentPath === href;
---
<header id="header" class="fixed top-0 left-0 w-full z-[1002] py-3 transition-all duration-300 bg-navy/95 backdrop-blur-xl shadow-lg">
  <nav class="max-w-[1200px] mx-auto px-6 flex items-center justify-between">
    <a href="/" aria-label="JCBO Conseil" class="group z-[1002] flex flex-col items-center justify-center">
      <img src="/images/logo.png" alt="JCBO Conseil" width="75" height="88" class="transition-all group-hover:drop-shadow-[0_0_8px_rgba(212,167,98,0.5)]" />
      <span class="text-[0.55rem] text-gold uppercase tracking-widest font-semibold mt-1 hidden md:block text-center leading-tight">Accélérez votre croissance.<br/>Révélez votre potentiel.</span>
    </a>
    <button id="navToggle" aria-label="Menu" aria-expanded="false" class="lg:hidden flex flex-col gap-[5px] bg-none border-none p-2 z-[1002] relative">
      <span class="block w-6 h-0.5 bg-white rounded transition-all origin-center" id="burger1"></span>
      <span class="block w-6 h-0.5 bg-white rounded transition-all" id="burger2"></span>
      <span class="block w-6 h-0.5 bg-white rounded transition-all origin-center" id="burger3"></span>
    </button>
    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-0.5">
      {navLinks.map(link => (
        <li><a href={link.href} class:list={["nav-link text-[0.8rem] font-medium px-2.5 py-2 rounded-lg transition-colors", isActive(link.href) ? "text-gold" : "text-white hover:text-gold-light"]}>{link.label}</a></li>
      ))}
      <li><a href="/reserver" class:list={["text-[0.8rem] font-bold px-4 py-2 rounded-full transition-all ml-1", isActive('/reserver') ? "bg-gold-light text-navy" : "border border-gold text-gold hover:bg-gold hover:text-navy"]}>Réserver</a></li>
      <li><a href="/contact" class="bg-gold text-navy font-semibold rounded-full px-4 py-2 text-[0.8rem] hover:bg-gold-light hover:-translate-y-0.5 transition-all ml-1">Contact</a></li>
    </ul>
  </nav>
</header>

<!-- Mobile fullscreen overlay menu -->
<div id="mobileMenu" class="fixed inset-0 z-[1001] bg-navy flex flex-col items-center justify-start gap-1 transition-all duration-300 opacity-0 invisible lg:hidden overflow-y-auto pt-[140px] pb-10">
  {navLinks.map(link => (
    <a href={link.href} class:list={["mobile-nav-link text-xl font-heading font-semibold py-3 px-8 rounded-lg transition-colors", isActive(link.href) ? "text-gold" : "text-white hover:text-gold"]}>{link.label}</a>
  ))}
  <div class="w-20 h-px bg-gold/20 my-3"></div>
  {mobileExtra.map(link => (
    <a href={link.href} class:list={["mobile-nav-link text-base font-heading font-medium py-2 px-8 rounded-lg transition-colors", isActive(link.href) ? "text-gold" : "text-white/60 hover:text-gold"]}>{link.label}</a>
  ))}
  <div class="flex gap-3 mt-5">
    <a href="/reserver" class="bg-white/10 border border-gold text-gold font-bold rounded-full px-8 py-3 text-base hover:bg-gold hover:text-navy transition-all">Réserver une séance</a>
  </div>
  <a href="/contact" class="mt-3 bg-gold text-navy font-bold rounded-full px-10 py-3.5 text-base hover:bg-gold-light transition-all">Contact</a>
  <div class="mt-8 flex gap-4">
    <a href="https://www.facebook.com/profile.php?id=61553882894803" target="_blank" rel="noopener" aria-label="Facebook" class="w-10 h-10 rounded-full border border-gold/30 flex items-center justify-center text-gold hover:bg-gold hover:text-navy transition-all">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
    </a>
    <a href="https://www.linkedin.com/in/jean-christophe-boyang-tsang-business-b16a08a6/" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-10 h-10 rounded-full border border-gold/30 flex items-center justify-center text-gold hover:bg-gold hover:text-navy transition-all">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
    </a>
  </div>
  <p class="mt-6 text-white/20 text-xs">+33 6 15 63 09 38 · contact@jcbo-conseil.com</p>
</div>

<!-- Sticky CTA mobile -->
<div id="stickyCta" class="fixed bottom-0 left-0 w-full bg-navy/95 backdrop-blur-lg border-t border-gold/20 p-3 z-[999] translate-y-full transition-transform duration-300 md:hidden">
  <a href="/contact" class="flex items-center justify-center gap-2 bg-gold text-navy font-bold py-3 rounded-full text-sm animate-pulse-gold">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    Être recontacté
  </a>
</div>
