---
const starSvg = `<svg width="16" height="16" viewBox="0 0 24 24" fill="#d4a762"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>`;
const googleSvg = `<svg width="14" height="14" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>`;

const reviews = [
  {
    initials: 'JP',
    name: 'Jean-Philippe L.',
    role: 'Consultant & Chef d\'entreprise',
    text: '« Sa passion pour le sujet et sa capacité à transmettre des concepts de manière claire ont grandement enrichi mon apprentissage. Une expérience solide dans la vente. Je recommande !! »',
    result: '+40% de closing',
  },
  {
    initials: 'SL',
    name: 'Sandra L. R.',
    role: 'Étudiante en Marketing',
    text: '« Mon carnet d\'adresses s\'est étoffé des coordonnées d\'experts qui me sont utiles aujourd\'hui. Entièrement satisfaite. Un grand Merci à Jean-Christophe BOYANG. »',
    result: 'Réseau x3',
  },
  {
    initials: 'DA',
    name: 'David A.',
    role: 'Dirigeant d\'entreprise',
    text: '« Il a identifié rapidement les axes d\'amélioration de notre stratégie. Son approche pragmatique et son expérience terrain ont permis d\'augmenter notre CA de 35% en un an. »',
    result: '+35% de CA',
  },
  {
    initials: 'ML',
    name: 'Marie L.',
    role: 'Responsable commerciale',
    text: '« L\'approche pratique et les méthodologies approuvées m\'ont permis de développer des compétences directement applicables. Un investissement qui vaut chaque centime. »',
    result: 'ROI immédiat',
  },
];
---
<section class="py-20 md:py-28 bg-white" id="testimonials">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-14" data-animate="fade-up">
      <span class="inline-block font-accent italic text-gold text-sm uppercase tracking-[0.1em] mb-2">Preuve sociale</span>
      <h2 class="font-heading text-[clamp(1.8rem,4vw,2.8rem)] font-bold text-navy mb-4">Ils ont <span class="text-gold">accéléré</span> leur croissance</h2>
      <div class="w-14 h-0.5 bg-gold mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {reviews.map((r, i) => (
        <article class="bg-offwhite border border-gold/10 rounded-2xl p-7 hover:shadow-xl hover:-translate-y-1 transition-all" data-animate="fade-up" data-delay={String(i * 120)}>
          <div class="flex items-center justify-between mb-4">
            <div class="flex gap-0.5" set:html={starSvg.repeat(5)} />
            <span class="inline-flex items-center gap-1.5 bg-green-50 text-green-700 text-xs font-bold px-3 py-1 rounded-full">{r.result}</span>
          </div>
          <blockquote class="font-accent italic text-gray-700 leading-relaxed mb-5">{r.text}</blockquote>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-full bg-navy text-gold font-heading font-bold text-sm flex items-center justify-center">{r.initials}</div>
              <div>
                <strong class="block text-sm text-navy">{r.name}</strong>
                <span class="text-xs text-gray-400">{r.role}</span>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 text-[0.65rem] text-gray-400 bg-white px-2.5 py-1 rounded-full border border-gray-100" set:html={googleSvg + ' Avis Google'} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
